# bilibili_learning 密钥管理 (.env 占位符, 真值在 .env, .env 已被 gitignore)
#
# 复制本文件为 .env 并填入真值:
#   cp .env.example .env
#   chmod 600 .env   (Linux/WSL)
#
# .env 文件**绝不**提交到 git, **绝不**贴到对话/聊天记录/截图

# ─────────────────────────────────────────────
# LLM Provider 1: minimax (主用)
# ─────────────────────────────────────────────
# 在 minimax 平台 (https://platform.minimaxi.com/) 创建 API key
# 建议设置:
#   - 用途标签: bilibili_learning_pipeline
#   - 额度上限: 50元 (够跑 100+ 视频)
#   - 过期时间: 30 天
#   - IP 白名单: 你的家庭 IP (如果支持)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M3

# ─────────────────────────────────────────────
# LLM Provider 2: OpenAI (备用)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# LLM Provider 3: Anthropic Claude (备用)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─────────────────────────────────────────────
# B 站登录态 (用 cookie_exporter.py 自动生成, 不在这里手填)
# ─────────────────────────────────────────────
# BILIBILI_SESSDATA=
# BILIBILI_BILI_JCT=
# BILIBILI_BUVID3=