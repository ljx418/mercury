    "SchemaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultType",
        "validationScope",
        "schemaIds",
        "schemasChecked",
        "instancesChecked",
        "failures"
      ],
      "properties": {
        "resultType": {
          "const": "schema"
        },
        "validationScope": {
          "enum": [
            "schema_meta",
            "fixture_instances"
          ]
        },
        "schemaIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "v2_knowledge_status",
              "v2_external_brain_workspace_contracts",
              "v2_external_brain_acceptance_manifest",
              "v2_external_brain_report",
              "v2_external_brain_screenshot_metadata",
              "v2_external_brain_execution_observation",
              "v2_external_brain_human_review",
              "v2_external_brain_validation_contracts",
              "v2_external_brain_architecture_scan_manifest"
            ]
          }
        },
        "schemasChecked": {
          "type": "integer",
          "minimum": 1
        },
        "instancesChecked": {
          "type": "integer",
          "minimum": 0
        },
        "positiveInstanceSetId": {
          "const": "v2-external-brain-px-0.1b-positive-instances/v10"
        },
        "positiveInstanceIndexSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "positiveInstanceIdsChecked": {
          "type": "array",
          "minItems": 65,
          "maxItems": 65,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixtureSuiteId": {
          "const": "v2-external-brain-px-0.1b-fixtures/v10"
        },
        "fixtureSuiteSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixtureRequirementIdsChecked": {
          "type": "array",
          "minItems": 109,
          "maxItems": 109,
          "uniqueItems": true,
          "items": {
            "$ref": "v2_external_brain_validation_contracts.schema.json#/$defs/RequirementId"
          }
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validationScope": {
                "const": "fixture_instances"
              }
            },
            "required": [
              "validationScope"
            ]
          },
          "then": {
            "required": [
              "positiveInstanceSetId",
              "positiveInstanceIndexSha256",
              "positiveInstanceIdsChecked",
              "fixtureSuiteId",
              "fixtureSuiteSha256",
              "fixtureRequirementIdsChecked"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "validationScope": {
                "const": "schema_meta"
              }
            },
            "required": [
              "validationScope"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "positiveInstanceSetId"
                  ]
                },
                {
                  "required": [
                    "fixtureSuiteId"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
