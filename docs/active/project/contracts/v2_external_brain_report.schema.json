{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v2_external_brain_report.schema.json",
  "title": "V2-PX Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "evidenceClass",
    "acceptanceMode",
    "claim",
    "passed",
    "humanReview",
    "summary",
    "gateResults",
    "scenarioResults",
    "testCommands",
    "auditArtifacts",
    "fatalIssues",
    "majorIssues",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v2-external-brain-report/v12"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceClass": {
      "enum": [
        "contract_fixture",
        "production_acceptance"
      ]
    },
    "acceptanceMode": {
      "enum": [
        "contract_fixture",
        "real_chrome_dual_container"
      ]
    },
    "claim": {
      "enum": [
        "V2-PX External Brain Productization passed dual-container real-Chrome acceptance.",
        "V2-PX contract fixture satisfied the frozen semantic rules; not product acceptance evidence.",
        "V2-PX External Brain Productization acceptance did not pass."
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "humanReview": {
      "$ref": "#/$defs/HumanReviewRef"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "gateResults": {
      "$ref": "#/$defs/GateResults"
    },
    "scenarioResults": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      }
    },
    "testCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TestCommand"
      }
    },
    "auditArtifacts": {
      "$ref": "#/$defs/AuditArtifacts"
    },
    "fatalIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "majorIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidenceClass": {
            "const": "contract_fixture"
          }
        },
        "required": [
          "evidenceClass"
        ]
      },
      "then": {
        "properties": {
          "humanReview": {
            "properties": {
              "evidenceClass": {
                "const": "contract_fixture"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceClass": {
            "const": "production_acceptance"
          }
        },
        "required": [
          "evidenceClass"
        ]
      },
      "then": {
        "properties": {
          "humanReview": {
            "properties": {
              "evidenceClass": {
                "const": "production_acceptance"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceClass": {
            "const": "contract_fixture"
          }
        },
        "required": [
          "evidenceClass"
        ]
      },
      "then": {
        "properties": {
          "acceptanceMode": {
            "const": "contract_fixture"
          },
          "claim": {
            "const": "V2-PX contract fixture satisfied the frozen semantic rules; not product acceptance evidence."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceClass": {
            "const": "production_acceptance"
          }
        },
        "required": [
          "evidenceClass"
        ]
      },
      "then": {
        "properties": {
          "acceptanceMode": {
            "const": "real_chrome_dual_container"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "enum": [
              "V2-PX External Brain Productization passed dual-container real-Chrome acceptance.",
              "V2-PX contract fixture satisfied the frozen semantic rules; not product acceptance evidence."
            ]
          },
          "humanReview": {
            "allOf": [
              {
                "$ref": "#/$defs/HumanReviewRef"
              },
              {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            ]
          },
          "fatalIssues": {
            "maxItems": 0
          },
          "majorIssues": {
            "maxItems": 0
          },
          "gateResults": {
            "$ref": "#/$defs/PassedGateResults"
          },
          "scenarioResults": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/ScenarioResult"
                },
                {
                  "properties": {
                    "passed": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "testCommands": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/TestCommand"
                },
                {
                  "properties": {
                    "passed": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passed": {
            "const": false
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "const": "V2-PX External Brain Productization acceptance did not pass."
          }
        }
      }
    }
  ],
  "$defs": {
    "RouteIntent": {
      "enum": [
        "source_detail",
        "source_library",
        "ask",
        "graph",
        "permissions"
      ]
    },
    "WorkspaceErrorCode": {
      "enum": [
        "WORKSPACE_NOT_FOUND",
        "SOURCE_NOT_FOUND",
        "FORBIDDEN",
        "INVALID_ROUTE",
        "RUNTIME_OFFLINE",
        "OPEN_WORKSPACE_FAILED",
        "UNSUPPORTED_HOST_STRATEGY"
      ]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCorpusTotal",
        "uniqueRealWebSources",
        "uniqueExplicitLocalDocumentSources",
        "uniqueNoteMarkdownSources",
        "scenariosTotal",
        "scenariosPassed",
        "entryPointsCovered",
        "routesCovered",
        "routeDirectOpenReloadPairs",
        "invalidOrForbiddenRecoverySamples",
        "idConsistencySamples",
        "statusFaultsCovered",
        "permissionSamples",
        "forgetSamples",
        "v2RegressionPassed"
      ],
      "properties": {
        "sourceCorpusTotal": {
          "type": "integer",
          "minimum": 12
        },
        "uniqueRealWebSources": {
          "type": "integer",
          "minimum": 6
        },
        "uniqueExplicitLocalDocumentSources": {
          "type": "integer",
          "minimum": 3
        },
        "uniqueNoteMarkdownSources": {
          "type": "integer",
          "minimum": 3
        },
        "scenariosTotal": {
          "type": "integer",
          "minimum": 12
        },
        "scenariosPassed": {
          "type": "integer",
          "minimum": 0
        },
        "entryPointsCovered": {
          "type": "integer",
          "minimum": 3
        },
        "routesCovered": {
          "type": "integer",
          "minimum": 5
        },
        "routeDirectOpenReloadPairs": {
          "type": "integer",
          "minimum": 5
        },
        "invalidOrForbiddenRecoverySamples": {
          "type": "integer",
          "minimum": 2
        },
        "idConsistencySamples": {
          "type": "integer",
          "minimum": 4
        },
        "statusFaultsCovered": {
          "type": "integer",
          "minimum": 4
        },
        "permissionSamples": {
          "type": "integer",
          "minimum": 3
        },
        "forgetSamples": {
          "type": "integer",
          "minimum": 3
        },
        "v2RegressionPassed": {
          "type": "boolean"
        }
      }
    },
    "GateResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G1_entry",
        "G2_route",
        "G3_lifecycle",
        "G4_architecture",
        "G5_status",
        "G6_ux_accessibility",
        "G7_evidence"
      ],
      "properties": {
        "G1_entry": {
          "type": "boolean"
        },
        "G2_route": {
          "type": "boolean"
        },
        "G3_lifecycle": {
          "type": "boolean"
        },
        "G4_architecture": {
          "type": "boolean"
        },
        "G5_status": {
          "type": "boolean"
        },
        "G6_ux_accessibility": {
          "type": "boolean"
        },
        "G7_evidence": {
          "type": "boolean"
        }
      }
    },
    "PassedGateResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G1_entry",
        "G2_route",
        "G3_lifecycle",
        "G4_architecture",
        "G5_status",
        "G6_ux_accessibility",
        "G7_evidence"
      ],
      "properties": {
        "G1_entry": {
          "const": true
        },
        "G2_route": {
          "const": true
        },
        "G3_lifecycle": {
          "const": true
        },
        "G4_architecture": {
          "const": true
        },
        "G5_status": {
          "const": true
        },
        "G6_ux_accessibility": {
          "const": true
        },
        "G7_evidence": {
          "const": true
        }
      }
    },
    "ObservedIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sidePanel",
        "background",
        "runtime",
        "workspace"
      ],
      "properties": {
        "sidePanel": {
          "$ref": "#/$defs/ObservedContainerIds"
        },
        "background": {
          "$ref": "#/$defs/ObservedContainerIds"
        },
        "runtime": {
          "$ref": "#/$defs/ObservedContainerIds"
        },
        "workspace": {
          "$ref": "#/$defs/ObservedContainerIds"
        }
      }
    },
    "ObservedContainerIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "not_applicable",
            "unavailable"
          ]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "workspaceId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_applicable",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "workspaceId"
                  ]
                },
                {
                  "required": [
                    "sourceId"
                  ]
                },
                {
                  "required": [
                    "operationId"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "StatusObservation": {
      "description": "A complete snapshot of the canonical Knowledge Status contract. Reusing the source contract prevents report and screenshot evidence from inventing a Runtime response while Runtime is offline.",
      "$ref": "v2_knowledge_status.schema.json"
    },
    "PermissionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeState",
        "afterState",
        "newScanStopped",
        "retainedImportedSources"
      ],
      "properties": {
        "beforeState": {
          "const": "granted"
        },
        "afterState": {
          "const": "revoked"
        },
        "newScanStopped": {
          "const": true
        },
        "retainedImportedSources": {
          "const": true
        }
      }
    },
    "ForgetVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "sourceId",
        "before",
        "after",
        "statusBefore",
        "statusAfter",
        "reopenChecks",
        "sharedItemRecomputed",
        "supportingSourceIds"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "$ref": "#/$defs/ForgetBefore"
        },
        "after": {
          "$ref": "#/$defs/ForgetAfter"
        },
        "statusBefore": {
          "allOf": [
            {
              "$ref": "v2_knowledge_status.schema.json"
            },
            {
              "properties": {
                "sourceBuildStatus": {
                  "const": "trace_ready"
                }
              }
            }
          ]
        },
        "statusAfter": {
          "allOf": [
            {
              "$ref": "v2_knowledge_status.schema.json"
            },
            {
              "properties": {
                "sourceBuildStatus": {
                  "const": "forgotten"
                }
              }
            }
          ]
        },
        "reopenChecks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "v2_external_brain_execution_observation.schema.json#/$defs/ForgetReopenCheck"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "mode": {
                    "const": "direct_open"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "mode": {
                    "const": "reload"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "mode": {
                    "const": "back"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "mode": {
                    "const": "reopen"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "sharedItemRecomputed": {
          "type": "boolean"
        },
        "supportingSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sharedItemRecomputed": {
                "const": true
              }
            },
            "required": [
              "sharedItemRecomputed"
            ]
          },
          "then": {
            "properties": {
              "supportingSourceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sharedItemRecomputed": {
                "const": false
              }
            },
            "required": [
              "sharedItemRecomputed"
            ]
          },
          "then": {
            "properties": {
              "supportingSourceIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "ForgetBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryPresent",
        "askPresent",
        "graphPresent",
        "tracePresent"
      ],
      "properties": {
        "libraryPresent": {
          "const": true
        },
        "askPresent": {
          "const": true
        },
        "graphPresent": {
          "const": true
        },
        "tracePresent": {
          "const": true
        }
      }
    },
    "ForgetAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryAbsent",
        "askAbsent",
        "graphAbsent",
        "traceAbsent"
      ],
      "properties": {
        "libraryAbsent": {
          "const": true
        },
        "askAbsent": {
          "const": true
        },
        "graphAbsent": {
          "const": true
        },
        "traceAbsent": {
          "const": true
        }
      }
    },
    "ScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "sourceSampleIds",
        "sourceKinds",
        "passed",
        "dataMode",
        "entryPoint",
        "routeIntent",
        "resolvedPath",
        "routeRecoveryResult",
        "openOutcome",
        "executionMode",
        "coverageTags",
        "successfulRecoveryModes",
        "workspaceId",
        "observedIds",
        "duplicateIngestDetected",
        "faultInjection",
        "statusObservation",
        "executionObservationPath",
        "executionObservationSha256",
        "screenshotPaths",
        "screenshotMetadataPaths",
        "logArtifacts",
        "conclusion"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSampleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "real_web",
              "explicit_local_document",
              "note_markdown"
            ]
          }
        },
        "passed": {
          "type": "boolean"
        },
        "dataMode": {
          "const": "real"
        },
        "entryPoint": {
          "enum": [
            "view_source",
            "open_workspace",
            "open_in_workspace",
            "direct_route",
            "status_recovery",
            "permission",
            "forget"
          ]
        },
        "routeIntent": {
          "$ref": "#/$defs/RouteIntent"
        },
        "resolvedPath": {
          "type": "string",
          "pattern": "^#/knowledge/"
        },
        "routeRecoveryResult": {
          "enum": [
            "not_applicable",
            "restored_direct_open",
            "restored_after_reload",
            "restored_after_back",
            "restored_after_reopen",
            "recovered_to_library",
            "blocked_with_recovery_action"
          ]
        },
        "openOutcome": {
          "enum": [
            "focused_existing",
            "created_new",
            "direct_open_restored",
            "recovered",
            "blocked",
            "not_applicable"
          ]
        },
        "executionMode": {
          "enum": [
            "contract_fixture",
            "headless_real_chrome",
            "visible_real_chrome"
          ]
        },
        "coverageTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "successfulRecoveryModes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct_open",
              "reload",
              "back",
              "reopen"
            ]
          }
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "observedIds": {
          "$ref": "#/$defs/ObservedIds"
        },
        "duplicateIngestDetected": {
          "type": "boolean"
        },
        "faultInjection": {
          "enum": [
            "none",
            "runtime_offline",
            "adapter_blocked",
            "data_service_unreachable",
            "source_failed",
            "source_degraded"
          ]
        },
        "statusObservation": {
          "$ref": "#/$defs/StatusObservation"
        },
        "errorCode": {
          "$ref": "#/$defs/WorkspaceErrorCode"
        },
        "permissionVerification": {
          "$ref": "#/$defs/PermissionVerification"
        },
        "forgetVerification": {
          "$ref": "#/$defs/ForgetVerification"
        },
        "executionObservationPath": {
          "type": "string",
          "minLength": 1
        },
        "executionObservationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "screenshotPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "screenshotMetadataPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "conclusion": {
          "enum": [
            "passed",
            "failed",
            "degraded",
            "blocked"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "duplicateIngestDetected": {
                "const": false
              },
              "conclusion": {
                "const": "passed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "passed": {
                "const": false
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "conclusion": {
                "enum": [
                  "failed",
                  "degraded",
                  "blocked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "routeRecoveryResult": {
                "enum": [
                  "recovered_to_library",
                  "blocked_with_recovery_action"
                ]
              }
            },
            "required": [
              "routeRecoveryResult"
            ]
          },
          "then": {
            "required": [
              "errorCode"
            ]
          }
        }
      ]
    },
    "TestCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testKind",
        "checkId",
        "command",
        "passed",
        "exitCode",
        "signal",
        "logArtifact",
        "result"
      ],
      "properties": {
        "testKind": {
          "enum": [
            "schema",
            "semantic",
            "architecture_boundary",
            "axe",
            "keyboard",
            "viewport",
            "chrome_e2e",
            "v2_regression"
          ]
        },
        "checkId": {
          "enum": [
            "schema_meta_validation",
            "schema_fixture_validation",
            "semantic_validator",
            "architecture_dependency_boundary",
            "architecture_forbidden_call_scan",
            "axe_accessibility",
            "keyboard_accessibility",
            "viewport_sidepanel_420",
            "viewport_sidepanel_360",
            "viewport_workspace_1280",
            "viewport_workspace_768",
            "chrome_e2e",
            "v2_regression"
