{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v2_px_collection_diagnostic.schema.json",
  "title": "Navia V2 PX Collection Diagnostic v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sourceRawRun", "generatedAt", "passed", "missingObservations", "issues", "generatorImplementation"],
  "properties": {
    "schemaVersion": {"const": "v2-px-collection-diagnostic/v1"}, "runId": {"type": "string", "minLength": 1}, "sourceRawRun": {"$ref": "#/$defs/ArtifactRef"}, "generatedAt": {"type": "string", "format": "date-time"}, "passed": {"const": false},
    "missingObservations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["requirementId", "numerator", "denominator", "observed", "required", "eventKinds", "scenarioIds"], "properties": {"requirementId": {"type": "string", "minLength": 1}, "numerator": {"type": "string", "minLength": 1}, "denominator": {"type": "string", "minLength": 1}, "observed": {"type": "integer", "minimum": 0}, "required": {"type": "integer", "minimum": 1}, "eventKinds": {"type": "array", "items": {"type": "string"}}, "scenarioIds": {"type": "array", "items": {"type": "string"}}}}},
    "issues": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "generatorImplementation": {"$ref": "#/$defs/ArtifactRef"}
  },
  "$defs": {"ArtifactRef": {"type": "object", "additionalProperties": false, "required": ["artifactRoot", "path", "sha256", "byteLength", "mediaType"], "properties": {"artifactRoot": {"enum": ["source_run", "validation_run", "repository_snapshot"]}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!virtual/)[^\\u0000]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "byteLength": {"type": "integer", "minimum": 0}, "mediaType": {"type": "string", "minLength": 1}}}}
}
