{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/schemas/v2-px-exit-manifest/v1",
  "title": "V2 PX T04 Unsigned Exit Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceClass", "t04RunId", "createdAt", "snapshotInputManifest", "snapshotRevalidation", "freshProductionPackage", "freshInvocationRecord", "chineseAcceptanceHtml", "drawio", "testArtifacts", "auditArtifacts", "publicEvidenceArchive", "publicArchivePolicy", "contentSha256", "signed", "humanReviewStatus", "g7Status", "finalPassed", "claim"],
  "properties": {
    "schemaVersion": {"const": "v2-px-exit-manifest/v1"},
    "evidenceClass": {"const": "production_acceptance"},
    "t04RunId": {"type": "string", "pattern": "^t04-r4-[a-z0-9-]+$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "snapshotInputManifest": {"$ref": "#/$defs/artifactRef"},
    "snapshotRevalidation": {"$ref": "#/$defs/artifactRef"},
    "freshProductionPackage": {"$ref": "#/$defs/artifactRef"},
    "freshInvocationRecord": {"$ref": "#/$defs/artifactRef"},
    "chineseAcceptanceHtml": {"$ref": "#/$defs/artifactRef"},
    "drawio": {"$ref": "#/$defs/artifactRef"},
    "testArtifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "auditArtifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifactRef"}},
    "publicEvidenceArchive": {"$ref": "#/$defs/artifactRef"},
    "publicArchivePolicy": {"const": "payload_only_excludes_exit_manifest_and_independent_audit"},
    "contentSha256": {"$ref": "#/$defs/sha256"},
    "signed": {"const": false},
    "humanReviewStatus": {"const": "pending"},
    "g7Status": {"const": "pending"},
    "finalPassed": {"const": false},
    "claim": {"const": "T04 isolated snapshot revalidation candidate passed; Human Review, G7, PX-5 final disposition and PX-6 remain pending."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRoot", "path", "sha256", "byteLength", "mediaType"],
      "properties": {
        "artifactRoot": {"enum": ["fresh_validation", "repository_snapshot", "t04_run"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1}
      }
    }
  }
}
