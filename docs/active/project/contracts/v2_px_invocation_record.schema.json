{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v2_px_invocation_record.schema.json",
  "title": "Navia V2 PX Invocation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceClass", "profile", "validationRunId", "sourceRunId", "recordedAt", "steps", "productionPackage", "exitCode", "passed", "claimBoundary"],
  "properties": {
    "schemaVersion": {"const": "v2-px-invocation-record/v1"},
    "evidenceClass": {"const": "production_acceptance"},
    "profile": {"const": "production_candidate"},
    "validationRunId": {"type": "string", "minLength": 1},
    "sourceRunId": {"type": "string", "minLength": 1},
    "recordedAt": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/InvocationStep"},
      "allOf": [
        {"contains": {"properties": {"stepId": {"const": "derive"}}, "required": ["stepId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"stepId": {"const": "validate"}}, "required": ["stepId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"stepId": {"const": "report"}}, "required": ["stepId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"stepId": {"const": "package"}}, "required": ["stepId"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "productionPackage": {"$ref": "#/$defs/ArtifactRef"},
    "exitCode": {"const": 0},
    "passed": {"const": true},
    "claimBoundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRoot", "path", "sha256", "byteLength", "mediaType"],
      "properties": {
        "artifactRoot": {"enum": ["source_run", "validation_run", "repository_snapshot"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!virtual/)[^\\u0000]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byteLength": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "InvocationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "implementation", "cwdRole", "argv", "exitCode", "signal", "stdout", "stderr"],
      "properties": {
        "stepId": {"enum": ["derive", "validate", "report", "package"]},
        "implementation": {"$ref": "#/$defs/ArtifactRef"},
        "cwdRole": {"enum": ["repository_root", "extension_root", "isolated_temp"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exitCode": {"const": 0},
        "signal": {"type": ["string", "null"]},
        "stdout": {"$ref": "#/$defs/ArtifactRef"},
        "stderr": {"$ref": "#/$defs/ArtifactRef"}
      }
    }
  }
}
