{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v2_px_raw_run.schema.json",
  "title": "Raw run provenance; payload shape is constrained by event kind",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "v2-px-raw-run/v2"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceClass": {
      "const": "production_acceptance"
    },
    "acceptanceProfile": {
      "const": "px5_r2_production_collection"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "buildIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "collectorImplementation": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "rawSchemaArtifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sealedAt": {
          "type": "string",
          "format": "date-time"
        },
        "algorithm": {
          "const": "sha256"
        },
        "inputMode": {
          "const": "canonical_json_without_seal_v1"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 1
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sealedAt",
        "algorithm",
        "inputMode",
        "contentSha256",
        "eventCount",
        "artifactCount"
      ]
    },
    "adapterMode": {
      "enum": [
        "mock",
        "data_service"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "runtimeSessionId": {
            "type": "string",
            "minLength": 1
          },
          "runtimePid": {
            "type": "integer",
            "minimum": 1
          },
          "runtimeStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "browserContextId": {
            "type": "string",
            "minLength": 1
          },
          "startedSequence": {
            "type": "integer",
            "minimum": 1
          },
          "endedSequence": {
            "type": "integer",
            "minimum": 1
          },
          "adapterMode": {
            "enum": [
              "mock",
              "data_service"
            ]
          },
          "faultInjections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "faultType": {
                  "enum": [
                    "runtime_offline",
                    "adapter_blocked",
                    "data_service_unreachable",
                    "source_failed"
                  ]
                },
                "startSequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "endSequence": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "faultType",
                "startSequence",
                "endSequence"
              ]
            }
          }
        },
        "required": [
          "segmentId",
          "runtimeSessionId",
          "runtimePid",
          "runtimeStartedAt",
          "browserContextId",
          "startedSequence",
          "endedSequence",
          "adapterMode",
          "faultInjections"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "monotonicMs": {
            "type": "number",
            "minimum": 0
          },
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "contextId": {
            "type": "string",
            "minLength": 1
          },
          "navigationId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "actionId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "kind": {
            "enum": [
              "navigation_start",
              "fault_start",
              "fault_end",
              "dom_action",
              "background_request",
              "background_response",
              "runtime_request",
              "runtime_response",
              "transport_failure",
              "route_observation",
              "container_observation",
              "screenshot",
              "command_result"
            ]
          },
          "payload": {
            "type": "object"
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          }
        },
        "required": [
          "eventId",
          "runId",
          "scenarioId",
          "sequence",
          "observedAt",
          "monotonicMs",
          "segmentId",
          "contextId",
          "navigationId",
          "actionId",
          "kind",
          "payload",
          "artifactRefs"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "navigation_start"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "navigationId": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "enum": [
                        "direct_open",
                        "reload",
                        "back",
                        "reopen",
                        "push",
                        "recovery"
                      ]
                    },
                    "priorNavigationId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "required": [
                    "url",
                    "mode",
                    "priorNavigationId"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "fault_start",
                    "fault_end"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "faultType": {
                      "enum": [
                        "runtime_offline",
                        "adapter_blocked",
                        "data_service_unreachable",
                        "source_failed"
                      ]
                    },
                    "target": {
                      "enum": [
                        "runtime_transport",
                        "adapter_status",
                        "data_service_status",
                        "source_operation"
                      ]
                    }
                  },
                  "required": [
                    "faultType",
                    "target"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "dom_action"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "isTrusted": {
                      "type": "boolean"
                    },
                    "eventType": {
                      "enum": [
                        "click",
                        "keydown"
                      ]
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "priorPath": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "isTrusted",
                    "eventType",
                    "target",
                    "url",
                    "priorPath"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "background_request"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "background_response"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requestEventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "requestEventId",
                    "message"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "runtime_request"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requestId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "bodyArtifact": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "path",
                            "sha256"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "method",
                    "url",
                    "requestId",
                    "bodyArtifact"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "runtime_response"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requestEventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "bodyArtifact": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "contentType": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "requestEventId",
                    "status",
                    "bodyArtifact",
                    "contentType"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "transport_failure"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requestEventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "errorCode": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "requestEventId",
                    "errorCode"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "route_observation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "enum": [
                        "direct_open",
                        "reload",
                        "back",
                        "reopen",
                        "push",
                        "recovery"
                      ]
                    },
                    "errorCode": {
                      "enum": [
                        "INVALID_ROUTE",
                        "WORKSPACE_NOT_FOUND",
                        "SOURCE_NOT_FOUND",
                        "FORBIDDEN"
                      ]
                    },
                    "ids": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "observed",
                            "not_applicable",
                            "unavailable"
                          ]
                        },
                        "workspaceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "operationId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "authorityEventIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "url",
                    "mode",
                    "ids",
                    "authorityEventIds"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "container_observation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "surface": {
                      "enum": [
                        "host_page",
                        "side_panel",
                        "workspace_page"
                      ]
                    },
                    "ids": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "observed",
                            "not_applicable",
                            "unavailable"
                          ]
                        },
                        "workspaceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "operationId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "authorityEventIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "surface",
                    "ids",
                    "authorityEventIds"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "screenshot"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "surface": {
                      "enum": [
                        "host_page",
                        "side_panel",
                        "workspace_page"
                      ]
                    },
                    "imageArtifact": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "metadataArtifact": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "observationEventIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "surface",
                    "imageArtifact",
                    "metadataArtifact",
                    "observationEventIds"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "command_result"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cwd": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exitCode": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "signal": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stdout": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "stderr": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "structuredResult": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "path",
                            "sha256"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "command",
                    "cwd",
                    "exitCode",
                    "signal",
                    "stdout",
                    "stderr",
                    "structuredResult"
                  ],
                  "anyOf": [
                    {
                      "properties": {
                        "exitCode": {
                          "type": "integer"
                        }
                      }
                    },
                    {
                      "properties": {
                        "signal": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "visibility": {
            "enum": [
              "public",
              "private_local_only"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "mediaType",
          "byteLength",
          "visibility"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "evidenceClass",
    "acceptanceProfile",
    "generatedAt",
    "snapshotCommit",
    "buildIndex",
    "collectorImplementation",
    "rawSchemaArtifact",
    "seal",
    "adapterMode",
    "segments",
    "events",
    "artifacts"
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "ObservedIds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "observed",
            "not_applicable",
            "unavailable"
          ]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ]
    }
  }
}
