{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v2_px_replay_invocation_record.schema.json",
  "title": "Navia V2 PX Resolved Replay Invocation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceClass", "profile", "resolutionAlgorithm", "sourceInvocation", "validationRunId", "sourceRunId", "recordedAt", "steps", "productionPackage", "exitCode", "passed", "claimBoundary"],
  "properties": {
    "schemaVersion": {"const": "v2-px-replay-invocation-record/v1"},
    "evidenceClass": {"const": "production_acceptance"},
    "profile": {"const": "production_candidate"},
    "resolutionAlgorithm": {"const": "artifact_root_rebase_validation_to_replay_v1"},
    "sourceInvocation": {"allOf": [{"$ref": "#/$defs/ReplayArtifactRef"}, {"properties": {"path": {"const": "invocation-record.json"}}}]},
    "validationRunId": {"type": "string", "minLength": 1},
    "sourceRunId": {"type": "string", "minLength": 1},
    "recordedAt": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/DeriveStep"},
        {"$ref": "#/$defs/ValidateStep"},
        {"$ref": "#/$defs/ReportStep"},
        {"$ref": "#/$defs/PackageStep"}
      ],
      "items": false
    },
    "productionPackage": {"$ref": "#/$defs/ReplayArtifactRef"},
    "exitCode": {"const": 0},
    "passed": {"const": true},
    "claimBoundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "RelativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!virtual(?:/|$))(?!.*\\/virtual(?:\\/|$))[^\\\\\\u0000]+$"},
    "ReplayArtifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactRoot", "path", "sha256", "byteLength", "mediaType"],
      "properties": {
        "artifactRoot": {"const": "replay_validation"},
        "path": {"$ref": "#/$defs/RelativePath"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "byteLength": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "Step": {
      "type": "object", "additionalProperties": false,
      "required": ["stepId", "implementation", "cwdRole", "argv", "exitCode", "signal", "stdout", "stderr"],
      "properties": {
        "stepId": {"enum": ["derive", "validate", "report", "package"]},
        "implementation": {"$ref": "#/$defs/ReplayArtifactRef"},
        "cwdRole": {"enum": ["repository_root", "extension_root", "isolated_temp"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exitCode": {"const": 0},
        "signal": {"type": ["string", "null"]},
        "stdout": {"$ref": "#/$defs/ReplayArtifactRef"},
        "stderr": {"$ref": "#/$defs/ReplayArtifactRef"}
      }
    },
    "DeriveStep": {"allOf": [{"$ref": "#/$defs/Step"}, {"properties": {"stepId": {"const": "derive"}}}]},
    "ValidateStep": {"allOf": [{"$ref": "#/$defs/Step"}, {"properties": {"stepId": {"const": "validate"}}}]},
    "ReportStep": {"allOf": [{"$ref": "#/$defs/Step"}, {"properties": {"stepId": {"const": "report"}}}]},
    "PackageStep": {"allOf": [{"$ref": "#/$defs/Step"}, {"properties": {"stepId": {"const": "package"}}}]}
  }
}
