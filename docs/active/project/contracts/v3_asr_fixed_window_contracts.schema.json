{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_asr_fixed_window_contracts.schema.json",
  "title": "Navia V3 ASR fixed-window qualification contracts",
  "oneOf": [
    {"$ref":"#/$defs/CandidateManifest"},
    {"$ref":"#/$defs/FixedWindowRun"}
  ],
  "$defs": {
    "Sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "SampleId": {"enum":["v3-asr-comparison-01","v3-asr-comparison-02","v3-asr-comparison-03"]},
    "ParentCandidate": {
      "type":"object","additionalProperties":false,
      "required":["candidateId","manifestSha256","providerId","engineVersion","asrModelSha256","vadModelSha256"],
      "properties": {
        "candidateId":{"const":"funasr-paraformer-q8-cpu-v1"},
        "manifestSha256":{"const":"2016e6e87baa440ac240fcf5ceb5653928e1f3b6c284ff586413bd42c71cd1cf"},
        "providerId":{"const":"funasr_edge_local"},
        "engineVersion":{"const":"runtime-llamacpp-v0.2.6"},
        "asrModelSha256":{"const":"42bf76ea1575a336aaca4c1b7c01a82b79113e6d04d0d6b799561bfcf07ee011"},
        "vadModelSha256":{"const":"1270f2559c495f4e7b6e739541151027d360761a3fda43fc147034f5719f5479"}
      }
    },
    "SourceCorpusEntry": {
      "type":"object","additionalProperties":false,
      "required":["sampleId","audioSha256","sourceFrameCount","durationMs","baselineElapsedMs","maximumElapsedMs"],
      "properties": {
        "sampleId":{"$ref":"#/$defs/SampleId"},
        "audioSha256":{"$ref":"#/$defs/Sha256"},
        "sourceFrameCount":{"type":"integer","minimum":1919984,"maximum":1920000},
        "durationMs":{"const":120000},
        "baselineElapsedMs":{"enum":[8180,7380,8140]},
        "maximumElapsedMs":{"enum":[16360,14760,16280]}
      },
      "allOf": [
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-01"}}},"then":{"properties":{"audioSha256":{"const":"2a11e09975733740d49f4a63ca7b3ec1a9ebc77e8e8897d770e1991d4c1beb05"},"sourceFrameCount":{"const":1919997},"baselineElapsedMs":{"const":8180},"maximumElapsedMs":{"const":16360}}}},
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-02"}}},"then":{"properties":{"audioSha256":{"const":"63eb48d9027e1cfa09747d7261f9e2b7347cbec58daeb38b4aff09cdbd647405"},"sourceFrameCount":{"const":1920000},"baselineElapsedMs":{"const":7380},"maximumElapsedMs":{"const":14760}}}},
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-03"}}},"then":{"properties":{"audioSha256":{"const":"f4f61c09f8fe19828fb2085ef18459179d5142596b8107cef82df6c7bf7cc97b"},"sourceFrameCount":{"const":1920000},"baselineElapsedMs":{"const":8140},"maximumElapsedMs":{"const":16280}}}}
      ]
    },
    "FixedWindowPolicy": {
      "type":"object","additionalProperties":false,
      "required":["audioFormat","windowDurationMs","chunkDurationMs","chunkCountPerSample","totalChunkCount","overlapMs","maxConcurrency","expectedFrameCount","maximumTailPadFrames","tailPaddingPolicy","boundariesMs","retryPolicy","textPolicy","mergePolicy"],
      "properties": {
        "audioFormat":{"const":"pcm_s16le_mono_16000hz"},
        "windowDurationMs":{"const":120000},
        "chunkDurationMs":{"const":15000},
        "chunkCountPerSample":{"const":8},
        "totalChunkCount":{"const":24},
        "overlapMs":{"const":0},
        "maxConcurrency":{"const":1},
        "expectedFrameCount":{"const":1920000},
        "maximumTailPadFrames":{"const":16},
        "tailPaddingPolicy":{"const":"zero_pad_final_chunk_only_for_frozen_frame_shortfall"},
        "boundariesMs":{
          "const":[[0,15000],[15000,30000],[30000,45000],[45000,60000],[60000,75000],[75000,90000],[90000,105000],[105000,120000]]
        },
        "retryPolicy":{"const":"fresh_sample_attempt_from_chunk_zero"},
        "textPolicy":{"const":"preserve_provider_segments_no_cross_chunk_rewrite"},
        "mergePolicy":{"const":"validate_local_then_add_chunk_offset"}
      }
    },
    "ResourcePolicy": {
      "type":"object","additionalProperties":false,
      "required":["cpuCores","addressSpaceBytes","gpuAllowed","installedDiskCeilingBytes","maximumLatencyRegressionRatio"],
      "properties": {
        "cpuCores":{"const":8},"addressSpaceBytes":{"const":8589934592},"gpuAllowed":{"const":false},
        "installedDiskCeilingBytes":{"const":536870912},"maximumLatencyRegressionRatio":{"const":2.0}
      }
    },
    "QualityPolicy": {
      "type":"object","additionalProperties":false,
      "required":["sampleCount","binCount","reviewerCount","totalJudgments","minimumMeaningPreserved","minimumPerSample","maximumCriticalMeaningErrors","maximumNeitherAcceptable"],
      "properties": {
        "sampleCount":{"const":3},"binCount":{"const":24},"reviewerCount":{"const":2},"totalJudgments":{"const":48},
        "minimumMeaningPreserved":{"const":44},"minimumPerSample":{"const":15},
        "maximumCriticalMeaningErrors":{"const":0},"maximumNeitherAcceptable":{"const":0}
      }
    },
    "PublicEvidencePolicy": {
      "type":"object","additionalProperties":false,
      "required":["audioAllowed","transcriptTextAllowed","absolutePathAllowed","credentialAllowed","hashAndCountOnly"],
      "properties": {
        "audioAllowed":{"const":false},"transcriptTextAllowed":{"const":false},"absolutePathAllowed":{"const":false},
        "credentialAllowed":{"const":false},"hashAndCountOnly":{"const":true}
      }
    },
    "CandidateManifest": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","candidateId","stage","status","parentCandidate","orchestrator","sourceCorpus","fixedWindow","resourcePolicy","qualityPolicy","publicEvidencePolicy","notes"],
      "properties": {
        "schemaVersion":{"const":"v3-asr-fixed-window-candidate-manifest/v1"},
        "candidateId":{"const":"funasr-paraformer-q8-fixed15-cpu-v2"},
        "stage":{"const":"V3-2-0b-5.3"},
        "status":{"const":"document_candidate_not_authorized"},
        "parentCandidate":{"$ref":"#/$defs/ParentCandidate"},
        "orchestrator":{
          "type":"object","additionalProperties":false,
          "required":["entity","inputType","providerAdapter","processHost","portalNeutral","networkDuringInference"],
          "properties": {
            "entity":{"const":"FixedWindowAsrOrchestrator"},"inputType":{"const":"TaskAudioRef"},
            "providerAdapter":{"const":"FunAsrLlamaCppProviderAdapter"},"processHost":{"const":"NativeAsrProcessHost"},
            "portalNeutral":{"const":true},"networkDuringInference":{"const":false}
          }
        },
        "sourceCorpus":{
          "type":"array","minItems":3,"maxItems":3,"uniqueItems":true,
          "prefixItems":[
            {"allOf":[{"$ref":"#/$defs/SourceCorpusEntry"},{"properties":{"sampleId":{"const":"v3-asr-comparison-01"}},"required":["sampleId"]}]},
            {"allOf":[{"$ref":"#/$defs/SourceCorpusEntry"},{"properties":{"sampleId":{"const":"v3-asr-comparison-02"}},"required":["sampleId"]}]},
            {"allOf":[{"$ref":"#/$defs/SourceCorpusEntry"},{"properties":{"sampleId":{"const":"v3-asr-comparison-03"}},"required":["sampleId"]}]}
          ],
          "items":false
        },
        "fixedWindow":{"$ref":"#/$defs/FixedWindowPolicy"},
        "resourcePolicy":{"$ref":"#/$defs/ResourcePolicy"},
        "qualityPolicy":{"$ref":"#/$defs/QualityPolicy"},
        "publicEvidencePolicy":{"$ref":"#/$defs/PublicEvidencePolicy"},
        "notes":{"type":"array","minItems":3,"items":{"type":"string","minLength":1}}
      }
    },
    "ChunkObservation": {
      "type":"object","additionalProperties":false,
      "required":["chunkIndex","startMs","endMs","chunkSha256","segmentCount","outputTextSha256","elapsedMs"],
      "properties": {
        "chunkIndex":{"type":"integer","minimum":0,"maximum":7},
        "startMs":{"type":"integer","minimum":0,"maximum":105000},
        "endMs":{"type":"integer","minimum":15000,"maximum":120000},
        "chunkSha256":{"$ref":"#/$defs/Sha256"},
        "segmentCount":{"type":"integer","minimum":1},
        "outputTextSha256":{"$ref":"#/$defs/Sha256"},
        "elapsedMs":{"type":"integer","minimum":1}
      }
    },
    "SampleObservation": {
      "type":"object","additionalProperties":false,
      "required":["sampleId","sourceAudioSha256","attemptId","chunks","totalElapsedMs","latencyRegressionRatio","peakRssBytes","mergedOutputSha256"],
      "properties": {
        "sampleId":{"$ref":"#/$defs/SampleId"},"sourceAudioSha256":{"$ref":"#/$defs/Sha256"},
        "attemptId":{"type":"string","pattern":"^attempt_[a-f0-9]{16}$"},
        "chunks":{
          "type":"array","minItems":8,"maxItems":8,"uniqueItems":true,
          "prefixItems":[
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":0},"startMs":{"const":0},"endMs":{"const":15000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":1},"startMs":{"const":15000},"endMs":{"const":30000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":2},"startMs":{"const":30000},"endMs":{"const":45000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":3},"startMs":{"const":45000},"endMs":{"const":60000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":4},"startMs":{"const":60000},"endMs":{"const":75000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":5},"startMs":{"const":75000},"endMs":{"const":90000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":6},"startMs":{"const":90000},"endMs":{"const":105000}},"required":["chunkIndex","startMs","endMs"]}]},
            {"allOf":[{"$ref":"#/$defs/ChunkObservation"},{"properties":{"chunkIndex":{"const":7},"startMs":{"const":105000},"endMs":{"const":120000}},"required":["chunkIndex","startMs","endMs"]}]}
          ],
          "items":false
        },
        "totalElapsedMs":{"type":"integer","minimum":1,"maximum":16360},
        "latencyRegressionRatio":{"type":"number","exclusiveMinimum":0,"maximum":2.0},
        "peakRssBytes":{"type":"integer","minimum":1,"maximum":8589934592},
        "mergedOutputSha256":{"$ref":"#/$defs/Sha256"}
      },
      "allOf":[
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-01"}}},"then":{"properties":{"sourceAudioSha256":{"const":"2a11e09975733740d49f4a63ca7b3ec1a9ebc77e8e8897d770e1991d4c1beb05"},"totalElapsedMs":{"maximum":16360}}}},
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-02"}}},"then":{"properties":{"sourceAudioSha256":{"const":"63eb48d9027e1cfa09747d7261f9e2b7347cbec58daeb38b4aff09cdbd647405"},"totalElapsedMs":{"maximum":14760}}}},
        {"if":{"properties":{"sampleId":{"const":"v3-asr-comparison-03"}}},"then":{"properties":{"sourceAudioSha256":{"const":"f4f61c09f8fe19828fb2085ef18459179d5142596b8107cef82df6c7bf7cc97b"},"totalElapsedMs":{"maximum":16280}}}}
      ]
    },
    "FixedWindowRun": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","evidenceClass","runId","candidateManifestSha256","createdAt","samples","cleanup","secretScan","machinePassed"],
      "properties": {
        "schemaVersion":{"const":"v3-asr-fixed-window-run/v1"},
        "evidenceClass":{"enum":["contract_fixture","production_candidate"]},
        "runId":{"type":"string","pattern":"^v3-2-0b-5\\.3-[0-9]{8}T[0-9]{6}Z$"},
        "candidateManifestSha256":{"$ref":"#/$defs/Sha256"},
        "createdAt":{"type":"string","format":"date-time"},
        "samples":{
          "type":"array","minItems":3,"maxItems":3,"uniqueItems":true,
          "prefixItems":[
            {"allOf":[{"$ref":"#/$defs/SampleObservation"},{"properties":{"sampleId":{"const":"v3-asr-comparison-01"}},"required":["sampleId"]}]},
            {"allOf":[{"$ref":"#/$defs/SampleObservation"},{"properties":{"sampleId":{"const":"v3-asr-comparison-02"}},"required":["sampleId"]}]},
            {"allOf":[{"$ref":"#/$defs/SampleObservation"},{"properties":{"sampleId":{"const":"v3-asr-comparison-03"}},"required":["sampleId"]}]}
          ],
          "items":false
        },
        "cleanup":{
          "type":"object","additionalProperties":false,
          "required":["processCount","chunkFileCount","sourceAudioCount","stagingCount","privatePathReferenceCount","passed"],
          "properties":{"processCount":{"const":0},"chunkFileCount":{"const":0},"sourceAudioCount":{"const":0},"stagingCount":{"const":0},"privatePathReferenceCount":{"const":0},"passed":{"const":true}}
        },
        "secretScan":{
          "type":"object","additionalProperties":false,"required":["hitCount","passed"],
          "properties":{"hitCount":{"const":0},"passed":{"const":true}}
        },
        "machinePassed":{"type":"boolean"}
      }
    }
  }
}
