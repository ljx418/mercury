{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_knowledge_workspace_v1.schema.json",
  "title": "Navia V3 Knowledge Workspace",
  "type": "object",
  "required": ["schemaVersion", "itemId", "sourceRefs", "title", "summary", "body", "tags", "customFields", "priority", "lifecycleState", "revision", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": "v3-knowledge-item/v1"},
    "itemId": {"pattern": "^kni_[a-f0-9]{32}$"},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "summary": {"type": "string", "maxLength": 4000},
    "body": {"type": "string", "minLength": 1, "maxLength": 100000},
    "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
    "customFields": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 2000}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "lifecycleState": {"enum": ["active", "aging", "archived"]},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
