{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_media_capture_internal_relay_v2.schema.json",
  "title": "Navia V3 Internal Media Capture Relay Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "visibility", "portName", "audioShape", "senderPolicy", "limits", "ordering", "streamIdPolicy", "restartMarker", "messageTypes", "failureCodes", "stopReasons"],
  "properties": {
    "schemaVersion": { "const": "v3-media-capture-internal-relay/v2" },
    "visibility": { "const": "extension_internal_only" },
    "portName": { "const": "navia.mediaCapture.audio/v2" },
    "audioShape": {
      "const": {
        "encoding": "pcm_s16le",
        "sampleRateHz": 16000,
        "channels": 1,
        "sampleWidthBytes": 2,
        "payloadTransport": "base64_json_string"
      }
    },
    "senderPolicy": {
      "const": {
        "extensionId": "current_extension_exact",
        "url": "exact_runtime_getURL_offscreen_document",
        "tab": "must_be_absent",
        "frameId": "absent_or_zero",
        "documentId": "bind_first_port_reject_replacement_while_active",
        "incognito": "must_equal_controller_context"
      }
    },
    "limits": {
      "const": {
        "maxRawChunkBytes": 49152,
        "maxEncodedChunkChars": 65536,
        "creditWindowChunks": 1,
        "runtimeMaxInFlightChunks": 1,
        "maxOutstandingChunks": 32,
        "maxOutstandingRawBytes": 1572864,
        "portConnectTimeoutMs": 5000,
        "runtimeStartTimeoutMs": 10000,
        "chunkAckTimeoutMs": 10000,
        "cleanupTimeoutMs": 10000,
        "finalizeTimeoutMs": 120000,
        "maxCaptureMs": 900000,
        "maxCaptureBytes": 536870912
      }
    },
    "ordering": {
      "const": {
        "firstSequence": 0,
        "increment": 1,
        "ackSource": "runtime_chunkAccepted",
        "creditReturn": "after_runtime_ack_only",
        "outstandingAccounting": "offscreen_local_plus_port_unacked_plus_runtime_inflight",
        "chunkBeforeRuntimeStarted": "reject",
        "chunkAfterStop": "reject",
        "overflowBehavior": "abort_without_drop"
      }
    },
    "streamIdPolicy": {
      "const": {
        "allowedMessage": "background_to_offscreen_start_once",
        "memoryLifetime": "until_getUserMedia_settles_or_abort",
        "forbiddenLocations": ["chunk", "ack", "log", "restartMarker", "storage", "publicEvidence"]
      }
    },
    "restartMarker": {
      "const": {
        "storage": "chrome.storage.session",
        "accessLevel": "TRUSTED_CONTEXTS",
        "schemaVersion": "v3-media-capture-restart-marker/v2",
        "fields": ["schemaVersion", "captureSessionId", "taskId", "startedAt", "phase", "expiresAt"],
        "captureSessionId": "cap_ plus 32 base64url chars from 192 random bits",
        "phaseValues": ["connecting", "runtime_started", "capturing", "stopping", "cleanup_pending"],
        "maxRetentionMs": 1020000,
        "forbiddenFields": ["ticket", "grantId", "streamId", "pcm", "sourceIdentity", "absolutePath", "cookie", "apiKey"],
        "clearRule": "after_terminal_and_cleanup_receipt_or_startup_reconciliation_grace",
        "restartBehavior": "fail_old_task_wait_cleanup_grace_clear_marker_never_resume",
        "sinkZeroEvidenceOwner": "runtime_finally_plus_real_integration_observer"
      }
    },
    "messageTypes": {
      "const": {
        "backgroundToOffscreen": ["start", "chunk_credit", "stop", "abort"],
        "offscreenToBackground": ["ready", "chunk", "stopped", "capture_error"]
      }
    },
    "failureCodes": {
      "const": [
        "V3_MEDIA_CAPTURE_PORT_FORBIDDEN",
        "V3_MEDIA_CAPTURE_PORT_DISCONNECTED",
        "V3_MEDIA_CAPTURE_PROTOCOL_INVALID",
        "V3_MEDIA_CAPTURE_BACKPRESSURE",
        "V3_MEDIA_CAPTURE_WORKER_RESTARTED",
        "V3_MEDIA_CAPTURE_RUNTIME_DISCONNECTED",
        "V3_MEDIA_CAPTURE_CLEANUP_INCOMPLETE",
        "V3_MEDIA_CAPTURE_AUDIO_SHAPE_INVALID",
        "V3_MEDIA_CAPTURE_CHUNK_INVALID",
        "V3_MEDIA_CAPTURE_CHUNK_SEQUENCE_INVALID",
        "V3_MEDIA_CAPTURE_BYTE_LIMIT",
        "V3_MEDIA_CAPTURE_DURATION_LIMIT",
        "V3_MEDIA_CAPTURE_EMPTY",
        "V3_MEDIA_CAPTURE_STREAM_INVALID",
        "V3_MEDIA_CAPTURE_TICKET_INVALID",
        "V3_MEDIA_CAPTURE_TICKET_EXPIRED",
        "V3_MEDIA_CAPTURE_TICKET_REPLAYED",
        "V3_MEDIA_CAPTURE_BINDING_MISMATCH",
        "V3_MEDIA_CAPTURE_ALREADY_ACTIVE",
        "V3_MEDIA_CAPTURE_FINALIZE_FAILED"
      ]
    },
    "stopReasons": {
      "const": ["completed", "cancelled", "navigation", "tab_closed", "consent_revoked", "runtime_disconnected", "timeout", "failed"]
    }
  }
}
