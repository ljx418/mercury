{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_media_credential_lease_contracts.schema.json",
  "title": "Navia V3.1.3 public credential channel and lease evidence contracts",
  "type": "object",
  "required": [
    "channel",
    "lease",
    "transportAudit"
  ],
  "additionalProperties": false,
  "properties": {
    "channel": {
      "$ref": "#/$defs/PortalCredentialChannelRecord"
    },
    "lease": {
      "$ref": "#/$defs/PortalCredentialLease"
    },
    "transportAudit": {
      "$ref": "#/$defs/CredentialTransportAuditRecord"
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "FailureCode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "V3_MEDIA_RUNTIME_AUTH_REQUIRED",
        "V3_MEDIA_RUNTIME_ORIGIN_MISMATCH",
        "V3_MEDIA_CHANNEL_INVALID",
        "V3_MEDIA_CHANNEL_EXPIRED",
        "V3_MEDIA_CHANNEL_REPLAYED",
        "V3_MEDIA_ENVELOPE_INVALID",
        "V3_MEDIA_ENVELOPE_TOO_LARGE",
        "V3_MEDIA_ENVELOPE_EXPIRED",
        "V3_MEDIA_ENVELOPE_REPLAYED",
        "V3_MEDIA_POLICY_NOT_GRANTED",
        "V3_MEDIA_POLICY_REVISION_MISMATCH",
        "V3_MEDIA_CREDENTIAL_SET_INVALID",
        "V3_MEDIA_LEASE_TASK_MISMATCH",
        "V3_MEDIA_LEASE_EXPIRED",
        "V3_MEDIA_LEASE_REVOKED",
        "V3_MEDIA_SECRET_CLEANUP_FAILED",
        "V3_MEDIA_CREDENTIAL_TRANSPORT_FAILED"
      ]
    },
    "PortalCredentialChannelRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "channelId",
        "taskId",
        "adapterId",
        "policyId",
        "policyRevision",
        "browserSessionBindingSha256",
        "extensionOriginSha256",
        "credentialNameSetSha256",
        "transport",
        "oneShot",
        "channelTokenPersisted",
        "issuedAt",
        "expiresAt",
        "status",
        "failureCode"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "portal-credential-channel-record/v1"
        },
        "channelId": {
          "type": "string",
          "pattern": "^pch_[a-f0-9]{32}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^media_task_[a-f0-9]{32}$"
        },
        "adapterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "policyId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+-media-consent/v[1-9][0-9]*$"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "browserSessionBindingSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "extensionOriginSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "credentialNameSetSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "transport": {
          "const": "authenticated_loopback_one_shot"
        },
        "oneShot": {
          "const": true
        },
        "channelTokenPersisted": {
          "const": false
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "issued",
            "consumed",
            "expired",
            "revoked",
            "failed"
          ]
        },
        "failureCode": {
          "$ref": "#/$defs/FailureCode"
        }
      }
    },
    "PortalCredentialLease": {
      "type": "object",
      "required": [
        "schemaVersion",
        "leaseId",
        "envelopeId",
        "taskId",
        "adapterId",
        "policyId",
        "policyRevision",
        "browserSessionBindingSha256",
        "credentialNameSetSha256",
        "credentialCount",
        "transportMode",
        "secretStorage",
        "serverValidationStatus",
        "issuedAt",
        "expiresAt",
        "state",
        "failureCode"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "portal-credential-lease/v1"
        },
        "leaseId": {
          "type": "string",
          "pattern": "^pcl_[a-f0-9]{32}$"
        },
        "envelopeId": {
          "type": "string",
          "pattern": "^pce_[a-f0-9]{32}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^media_task_[a-f0-9]{32}$"
        },
        "adapterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "policyId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+-media-consent/v[1-9][0-9]*$"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "browserSessionBindingSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "credentialNameSetSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "credentialCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "transportMode": {
          "const": "one_shot_envelope"
        },
        "secretStorage": {
          "const": "runtime_process_memory_only"
        },
        "serverValidationStatus": {
          "const": "not_performed"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "active",
            "consumed",
            "expired",
            "revoked",
            "failed"
          ]
        },
        "failureCode": {
          "$ref": "#/$defs/FailureCode"
        }
      }
    },
    "CredentialTransportAuditRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "requestBodyBytes",
        "requestAttemptCount",
        "requestBodyLogged",
        "eventStorePayloadWritten",
        "traceArgumentWritten",
        "exceptionBodyWritten",
        "retryBodyPersisted",
        "rawCredentialValueHashed",
        "persistentSecretHitCount",
        "publicSecretHitCount",
        "genericRuntimeProxyDenied",
        "contentScriptDenied",
        "exactOriginBound",
        "replayRejected",
        "expiredChannelRejected",
        "runtimeRestartClearedLeases",
        "revocationClearedLease"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "credential-transport-audit/v1"
        },
        "requestBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "requestAttemptCount": {
          "const": 1
        },
        "requestBodyLogged": {
          "const": false
        },
        "eventStorePayloadWritten": {
          "const": false
        },
        "traceArgumentWritten": {
          "const": false
        },
        "exceptionBodyWritten": {
          "const": false
        },
        "retryBodyPersisted": {
          "const": false
        },
        "rawCredentialValueHashed": {
          "const": false
        },
        "persistentSecretHitCount": {
          "const": 0
        },
        "publicSecretHitCount": {
          "const": 0
        },
        "genericRuntimeProxyDenied": {
          "const": true
        },
        "contentScriptDenied": {
          "const": true
        },
        "exactOriginBound": {
          "const": true
        },
        "replayRejected": {
          "const": true
        },
        "expiredChannelRejected": {
          "const": true
        },
        "runtimeRestartClearedLeases": {
          "const": true
        },
        "revocationClearedLease": {
          "const": true
        }
      }
    }
  }
}
