{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_media_dependency_api_v1.schema.json",
  "title": "Navia V3 media dependency API envelopes",
  "oneOf": [
    {"$ref": "#/$defs/createRequest"},
    {"$ref": "#/$defs/statusSuccess"},
    {"$ref": "#/$defs/jobSuccess"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "requestId": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,128}$"},
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyIds"],
      "properties": {"dependencyIds": {"const": ["yt-dlp"]}}
    },
    "statusSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {"ok": {"const": true}, "data": {"$ref": "https://navia.local/contracts/v3_media_dependency_status_v1.schema.json"}, "error": {"type": "null"}, "request_id": {"$ref": "#/$defs/requestId"}}
    },
    "jobSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {"ok": {"const": true}, "data": {"type": "object", "additionalProperties": false, "required": ["job"], "properties": {"job": {"$ref": "https://navia.local/contracts/v3_media_dependency_installation_v1.schema.json"}}}, "error": {"type": "null"}, "request_id": {"$ref": "#/$defs/requestId"}}
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {
        "ok": {"const": false},
        "data": {"type": "null"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "recoverable", "details"],
          "properties": {
            "code": {"enum": ["V3_MEDIA_DEPENDENCY_REQUEST_INVALID", "V3_MEDIA_DEPENDENCY_JOB_NOT_FOUND", "V3_MEDIA_DEPENDENCY_JOB_ACTIVE", "V3_MEDIA_DEPENDENCY_SOURCE_NOT_ALLOWED", "V3_MEDIA_DEPENDENCY_NETWORK_FAILED", "V3_MEDIA_DEPENDENCY_TIMEOUT", "V3_MEDIA_DEPENDENCY_SIZE_MISMATCH", "V3_MEDIA_DEPENDENCY_HASH_MISMATCH", "V3_MEDIA_DEPENDENCY_DISK_SPACE_LOW", "V3_MEDIA_DEPENDENCY_PERMISSION_DENIED", "V3_MEDIA_DEPENDENCY_SELF_TEST_FAILED", "V3_MEDIA_DEPENDENCY_RUNTIME_RESTARTED", "V3_MEDIA_DEPENDENCY_SYSTEM_TOOL_MISSING", "V3_MEDIA_DEPENDENCY_NOT_READY"]},
            "message": {"type": "string", "minLength": 1, "maxLength": 240},
            "recoverable": {"type": "boolean"},
            "details": {"type": "object", "additionalProperties": false, "properties": {"dependencyId": {"enum": ["yt-dlp", "ffmpeg", "ffprobe", "sensevoice"]}, "jobId": {"type": "string", "pattern": "^media_dep_job_[a-f0-9]{32}$"}}}
          }
        },
        "request_id": {"$ref": "#/$defs/requestId"}
      }
    }
  }
}
