{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_media_local_import_api_v1.schema.json",
  "title": "Navia V3 explicit local media import API",
  "oneOf": [
    {"$ref": "#/$defs/createRequest"},
    {"$ref": "#/$defs/createSuccess"},
    {"$ref": "#/$defs/statusSuccess"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "requestId": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,128}$"},
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sourceIdentity", "declaredMediaType", "byteLength"],
      "properties": {
        "taskId": {"type": "string", "pattern": "^media_task_[a-f0-9]{32}$"},
        "sourceIdentity": {"type": "string", "pattern": "^portal:[a-z][a-z0-9_-]{1,31}:[^:]{1,128}:[^:]{1,128}:[^:]{1,128}$"},
        "declaredMediaType": {"enum": ["video/mp4", "video/webm", "video/x-matroska", "application/octet-stream"]},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 2147483648}
      }
    },
    "createSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {
        "ok": {"const": true},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["import", "uploadToken"],
          "properties": {
            "import": {"$ref": "https://navia.local/contracts/v3_media_local_import_status_v1.schema.json"},
            "uploadToken": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
          }
        },
        "error": {"type": "null"},
        "request_id": {"$ref": "#/$defs/requestId"}
      }
    },
    "statusSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {
        "ok": {"const": true},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["import"],
          "properties": {"import": {"$ref": "https://navia.local/contracts/v3_media_local_import_status_v1.schema.json"}}
        },
        "error": {"type": "null"},
        "request_id": {"$ref": "#/$defs/requestId"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "error", "request_id"],
      "properties": {
        "ok": {"const": false},
        "data": {"type": "null"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "recoverable", "details"],
          "properties": {
            "code": {"enum": ["V3_MEDIA_IMPORT_REQUEST_INVALID", "V3_MEDIA_IMPORT_AUTH_REQUIRED", "V3_MEDIA_IMPORT_ORIGIN_MISMATCH", "V3_MEDIA_IMPORT_NOT_FOUND", "V3_MEDIA_IMPORT_TASK_NOT_ELIGIBLE", "V3_MEDIA_IMPORT_ACTIVE", "V3_MEDIA_IMPORT_TOKEN_INVALID", "V3_MEDIA_IMPORT_SIZE_MISMATCH", "V3_MEDIA_IMPORT_SIZE_LIMIT", "V3_MEDIA_IMPORT_TYPE_UNSUPPORTED", "V3_MEDIA_IMPORT_MEDIA_INVALID", "V3_MEDIA_IMPORT_DURATION_LIMIT", "V3_MEDIA_IMPORT_DISK_SPACE_LOW", "V3_MEDIA_IMPORT_WRITE_FAILED", "V3_MEDIA_IMPORT_PREPARE_FAILED", "V3_MEDIA_IMPORT_RUNTIME_RESTARTED", "V3_MEDIA_IMPORT_CANCELLED", "V3_MEDIA_IMPORT_CLEANUP_INCOMPLETE"]},
            "message": {"type": "string", "minLength": 1, "maxLength": 240},
            "recoverable": {"type": "boolean"},
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "importId": {"type": "string", "pattern": "^media_import_[a-f0-9]{32}$"},
                "maximumBytes": {"const": 2147483648},
                "maximumDurationMs": {"const": 14400000}
              }
            }
          }
        },
        "request_id": {"$ref": "#/$defs/requestId"}
      }
    }
  }
}
