        </mxCell>
        <mxCell id="v2p-04-v24" value="四面 + durable 验证【T04 R4-E 已复验】&#xa;Library / Ask / Graph / Trace 均 absent&#xa;3 source × 4 mode 均 SOURCE_NOT_FOUND" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5f5df;strokeColor=#2e7d32;;fontSize=11;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
