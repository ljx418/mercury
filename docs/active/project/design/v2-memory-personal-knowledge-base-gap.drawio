  <diagram id="v2p-06" name="06 V2-PX 产品化开发计划与里程碑">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2p-06-t2" value="06 V2-PX 产品化开发计划与里程碑" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#0b5d52;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v3" value="冻结基线【已完成】&#xa;V2-1..V2-7 planning-aligned local knowledge acceptance&#xa;保留现有合同、Runtime API、mock-first Adapter 和 24 source / 38+ scenario 回归证据" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5f5df;strokeColor=#2e7d32;;fontSize=14;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-t3b" value="固定顺序：PX-0..4 → T01 → T02.x → T03 LIMITED PASS → T04 LIMITED PASS → T04.1 全量重跑 → PX6-0..5 机器包 → PX6-6 人审 → PX6-7 最终化。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#0b5d52;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v4" value="PX-0.1b 合同闭环 + PX-0.2 验收工具【均已通过】&#xa;Manifest v5 / Report v12 / Screenshot v6 / Execution v6 / Human v3 / Validation v4 / Architecture Scan v2&#xa;PX-0.2 第五轮独立复审 2026-09-01：Fatal 0 / Major 0 / Minor 0；PX-1 单独计划后 Conditional Go" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=10;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v5" value="PX-1 Workspace Entry【修复与独立复审均通过】&#xa;WXT / MV3 / CSP；五 route × 四恢复 20/20&#xa;8 并发只创建 1 tab；Runtime 权威恢复；0 ingest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="410" y="230" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v6" value="PX-2 Side Panel Quick Surface【实现与验收通过】&#xa;Save / Status + 四个 Workspace 入口 + Trace 快捷查看&#xa;真实 Runtime；360/420 无溢出；完整管理面不再挂载" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="760" y="230" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v7" value="PX-3 状态与生命周期同步【实现与验收通过】&#xa;sender-aware tab reuse + stable source/operation ID&#xa;poll/reconnect、tab close/create/reuse、0 ingest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1140" y="230" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v11" value="PX-4 Workspace 产品化组件【已实现 / 已验收】&#xa;SourceLibraryPanel / SourceDetailReader / AskWithSourcesPanel&#xa;EvidenceTraceDrawer / KnowledgeGraphCanvas / PermissionRootManager / ForgetSourceDialog / DataServiceStatusCard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v12" value="PX-5 T01/T02.x【阶段结论保留】&#xa;T02.5 sealed raw：12 source、5×4 route、3×4 Forget&#xa;T03 shared semantic/AST + pure report【LIMITED PASS】&#xa;G1-G6 passed；G7/Human/final 仍 pending/false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5f5df;strokeColor=#2e7d32;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="585" y="430" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v13" value="T04.1【LIMITED PASS】→ PX6-0..5【LIMITED PASS】&#xa;A01-A14：机器复算与20负例完成，强制停在人审&#xa;PX6-6：真人 H01-H07→ReviewSubmission&#xa;PX6-7：先冻结两步终审握手，再闭合 A15/A16 + G7/final；RKM 不在本阶段" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1110" y="430" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v17" value="阶段完成后的目标体验&#xa;用户在网页边缘完成当前页保存和快捷操作；需要长期整理时一键进入独立宽屏 Workspace。两个容器使用同一 Workspace / Source / Evidence / Operation，不重复导入、不丢失上下文。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=15;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v18" value="阶段停止条件&#xa;跨 run 拼接、修改 sealed raw、Report 作为输入、缺观察仍成功、自动签 Human、G4 信任 violations=0、相对路径依赖 cwd、规则/分母变化，立即回文档审计。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=14;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="840" y="650" width="700" height="135" as="geometry" />
        </mxCell>
        <mxCell id="v2p-06-v19" value="后续 KM-0..KM-7【延期研究，不属于 PX】　开源方案 spike → suggest-only proposals → grounded summary → Maintenance Inbox → archive / quarantine / restore → 高风险 opt-in forget。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;;fontSize=12;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="805" width="1480" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2p-07" name="07 自动化与人工验收计划">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2p-07-t2" value="07 自动化与人工验收计划" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#0b5d52;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-t3" value="T03/T04 已限定通过；T04.1 必须完整新跑。PX-6 先重算机器事实并强制停止，再由真实人类在可见 Chrome 审查，不得自动代签。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#a33a36;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1450" height="34" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v4" value="E2E-1 保存到来源详情&#xa;网页 Launcher → Side Panel → 读取 → 保存&#xa;trace_ready → 查看来源 → 新标签页 Source Detail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v5" value="E2E-2 打开工作台&#xa;Side Panel 快捷动作 / Know 顶部&#xa;打开同一 Workspace；原网页与 Side Panel 可保留" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="580" y="135" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v6" value="S3/S4 路由恢复&#xa;五 route × direct/reload/Back/reopen = 20 组合&#xa;INVALID_ROUTE / WORKSPACE_NOT_FOUND 各有可信回库" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5f5df;strokeColor=#2e7d32;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1100" y="135" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v7" value="E2E-4 跨容器与复用一致性&#xa;参与层 workspaceId / sourceId / operationId 一致&#xa;open_in 记录 prior route；tab reuse 两次 attempt 同 tab 且不重复 ingest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="325" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v8" value="E2E-5 生命周期异常&#xa;Runtime offline / Adapter blocked / data_service unreachable&#xa;source degraded / failed / retry / reconnect" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="580" y="325" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v9" value="S5 Permission / Durable Forget【T02.2 输入通过】&#xa;显式路径授权→手动 scan/import；撤销后 403、旧 source 保留&#xa;3 source × 4 重开：12 ERROR + 12 可信回库；四面 absent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#d5f5df;strokeColor=#2e7d32;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1100" y="325" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-e10" value="共享 ID 核验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607d8b;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="v2p-07-v4" target="v2p-07-v7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-e11" value="状态核验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607d8b;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="v2p-07-v5" target="v2p-07-v8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-e12" value="治理核验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607d8b;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="v2p-07-v6" target="v2p-07-v9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v13" value="T04.1 + PX-6 机器验收&#xa;• T04.1 A01-A14：全新 R4-P/R4-E/T02/T03/T04；root 全为 replay_validation&#xa;• PX6 A01-A14：绑定单一候选；17场景/12来源/20路由/12 Forget/4故障/4视口&#xa;• 63 rules / 109 fixtures / 42 mutations；PX6 N001-N020&#xa;• 机器成功只能 waiting_for_human_review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="535" width="710" height="195" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v14" value="PX6-6 人工产品体验 H01-H07&#xa;H01 三入口；H02 五路由四恢复；H03 三来源 Forget 四重开&#xa;H04 Runtime 权威与双容器边界；H05 四类故障可理解&#xa;H06 四视口/键盘/焦点/Escape；H07 抽查 hash/截图/日志/有限声明&#xa;每项必须 notes + ArtifactRef；失败必须 blocker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="830" y="535" width="710" height="195" as="geometry" />
        </mxCell>
        <mxCell id="v2p-07-v15" value="门禁：两轮内部文档审计 + Claude Code CLI 外审 Fatal 0/Major 0 + 用户另行代码授权。T04.1 与 PX6-0..5 分阶段授权；PX6-6 只接受人类提交；实现后再由新 reviewer 做出门审计。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=12;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="775" width="1480" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2p-08" name="08 验收门槛、出门条件与声明">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2p-08-t2" value="08 验收门槛、出门条件与声明" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#0b5d52;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v3" value="G1 入口 Gate&#xa;Execution Observation 证明 actor=user + trusted gesture + requestId 对应 background result；三个入口各≥2，不信任自报布尔值。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v4" value="G2 路由 Gate&#xa;Source Library / Detail / Ask / Graph / Permissions 五类 route 均覆盖 direct-open、reload、Back、reopen 且稳定 ID 一致；无效 ID 显示可恢复错误。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v5" value="G3 生命周期 Gate&#xa;保存后的 stable source 在 reload/reopen/Back 保持；Forget 记录 trace_ready→forgotten，同源四类重开均 SOURCE_NOT_FOUND；failed/degraded 不冒充成功。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1060" y="120" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v6" value="G4 架构 Gate&#xa;两类扫描绑定 commit、三项 root、inline/Git source bytes、blob/tree/path index；ruleset 固定 AST import + Call/New/endpoint 规范化扫描；PX-N-104..109 修改源码且保持 violations=0，必须仍被拒绝。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v7" value="G5 状态 Gate&#xa;Runtime / Adapter / data_service / source 状态不合并；每类故障给出不同解释和下一步动作。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v8" value="G6 UX / Accessibility Gate&#xa;axe/键盘/焦点/Escape 全过；Side Panel 360/420 与 Workspace 768/1280 的 Manifest、metadata、实际 PNG 解码尺寸三方相等；surface 不可冒充，合成图不计入。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1060" y="310" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v8b" value="PX-6 证据 Gate　T04.1 Minor closed；PX6-A01..A16；H01..H07；N001..N020；单一候选 path/raw hash；17/12/20/12 分母分开；Human passed 后 G7/final 才可 passed；最终外审 Fatal 0/Major 0。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="1480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v9" value="No-Go：拒绝 T04.1/PX-6 假绿&#xa;• 回写旧候选、局部补JSON或跨run拼接&#xa;• artifactRoot alias；目录扫描选择 newest&#xa;• 调用旧 generator/validator/PX-6 脚本&#xa;• 缩小17/12/20/12/63/109/42任一分母&#xa;• 自动填写 reviewer/时间/通过结论&#xa;• Human pending 时生成 success claim" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="710" height="185" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v10" value="分级允许声明&#xa;T04：isolated snapshot revalidation candidate LIMITED PASS。&#xa;PX6 machine：review package is ready for human review。&#xa;仅 Human/G7/final/外审全过后：dual-container real-Chrome acceptance passed。&#xa;RAG/RKM/V2全部完成仍禁止。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=13;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="830" y="555" width="710" height="185" as="geometry" />
        </mxCell>
        <mxCell id="v2p-08-v11" value="2026-09-15：T03/T04.1/PX6-0..5 LIMITED PASS。PX6-6 等真人；PX6-7 终审握手未冻结并保持 fail-closed。PX-5 FAIL / PX-6 未通过 / RKM NOT IMPLEMENTED。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1480" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
