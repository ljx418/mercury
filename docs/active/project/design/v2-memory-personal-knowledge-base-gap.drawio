          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2p-04-v15" value="ingesting / building 异常分支&#xa;degraded：保留原因与可用证据&#xa;failed：只允许用户显式 retry；cancel / resume unsupported&#xa;未保存 / 已 forgotten source 不得 direct-open；Graph 按 sourceId 删除&#xa;Runtime 重启后按稳定 ID 重新查询；缺失显示 recoverable error，不承诺恢复旧 operation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=11;fontStyle=0;align=left;verticalAlign=middle" vertex="1" parent="1">
