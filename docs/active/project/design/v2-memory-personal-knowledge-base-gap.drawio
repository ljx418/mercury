          <mxGeometry x="60" y="505" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="v2p-04-v21" value="Source Detail&#xa;用户发起 Forget" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=13;fontStyle=0;align=center;verticalAlign=middle" vertex="1" parent="1">
