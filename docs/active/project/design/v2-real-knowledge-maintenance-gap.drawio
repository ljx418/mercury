<mxCell id="rkm7_edge5" value="出门" edge="1" parent="1" source="rkm7_s8" target="rkm7_s9" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#526563;fontSize=13;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" y="-5" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
