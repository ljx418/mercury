<mxCell id="rkm4_edge3" value="云同意" edge="1" parent="1" source="rkm4_r5" target="rkm4_r7" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#526563;fontSize=12;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" y="-5" as="geometry"><Array as="points"><mxPoint x="800" y="654"/><mxPoint x="270" y="654"/></Array></mxGeometry></mxCell>
<mxCell id="rkm4_edge4" value="会话同意" edge="1" parent="1" source="rkm4_r6" target="rkm4_r7" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#526563;fontSize=12;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" y="-5" as="geometry"><Array as="points"><mxPoint x="1330" y="666"/><mxPoint x="270" y="666"/></Array></mxGeometry></mxCell>
<mxCell id="rkm4_edge5" value="代际撤销" edge="1" parent="1" source="rkm4_r7" target="rkm4_r8" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#526563;fontSize=12;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" y="-5" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="rkm4_edge6" value="复验" edge="1" parent="1" source="rkm4_r8" target="rkm4_r9" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#526563;fontSize=12;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" y="-5" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
