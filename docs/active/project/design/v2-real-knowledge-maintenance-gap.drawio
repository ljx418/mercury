<diagram id="v2-rkm-8" name="08 风险、文档门禁与有限出门声明"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="rkm8_title" value="08 风险、文档门禁与有限出门声明" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontFamily=Arial;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="42" as="geometry"/></mxCell>
<mxCell id="rkm8_subtitle" value="文档可供审查 ≠ 可执行合同完备 ≠ 产品通过｜独立审计与用户签署分离｜颜色不替代事实与证据" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontFamily=Arial;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1520" height="50" as="geometry"/></mxCell>
<mxCell id="rkm8_legend" value="绿：当前代码存在（验收另标）　橙：需修改/复验　蓝：待新增　灰：外部/范围外　红：门禁/风险　所有“待新增”仅为文档设计" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontFamily=Arial;spacing=4;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="119" width="1520" height="32" as="geometry"/></mxCell>
<mxCell id="rkm8_g1" value="当前状态｜禁止过度声明&#xa;&#xa;R1后端限定通过；前端/Chrome待验&#xa;PX-5 FAIL / REOPENED&#xa;PX-6 BLOCKED；RKM未开发&#xa;真实Adapter/机器合同/spike未完成&#xa;本轮最多形成文档设计基线" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#fce6e6;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g2" value="DOC-Closure 文档出门&#xa;&#xa;14需求 → E实体 → T任务 → S场景&#xa;G-1..G-7有确定性决定与反例义务&#xa;顶层断言39条，分母不可缩减&#xa;每场景有前置/操作/阈值/证据&#xa;文档通过不代替产品签署" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#e3f0fc;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g3" value="DS接入风险 D02/D03/D09&#xa;&#xa;能力仅五类处置，不设降级通过&#xa;not_observed/prd_blocker命中必需项即停&#xa;公共API不支持就停，不读内部文件&#xa;remove标记 ≠ 删除级联&#xa;双仓版本/源码/许可单独锁定" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#eeedf0;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g4" value="隐私与可逆边界 D04/D05&#xa;&#xa;文件/云/会话分别授权&#xa;默认关闭/suggest-only&#xa;云撤销不撤回已出站bytes&#xa;原始聊天/宿主原件不随Forget删除&#xa;自动永久删除和物理文件写入0" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#fce6e6;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g5" value="模型/用量/时区 D03/D05&#xa;&#xa;真实provider/model调用才计发送&#xa;Usage按eventKind映射四主桶&#xa;无日/月金额硬限，未知usage为null&#xa;daily时区由Policy所有者确认IANA&#xa;不得读取部署机隐式时区" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#e3f0fc;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g6" value="验收可信性 D05/D06/D08/D09&#xa;&#xa;原始事件/响应/PNG不可补写&#xa;原始字节负例要使扫描器真失败&#xa;39项registry不得缩分母&#xa;gold作者不得自审，至少一名独立审查&#xa;私有raw不放公开报告/审计包" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#fce6e6;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g7" value="允许的最终目标声明&#xa;&#xa;仅在全部门禁与用户签署后：&#xa;冻结语料与授权范围内&#xa;通过真实知识服务、指定对话记忆&#xa;及可逆维护验收&#xa;当前未达到，不能提前声明" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#e3f0fc;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g8" value="明确不在范围&#xa;&#xa;Docker / data_service Console替代UI&#xa;浏览历史全量采集 / 外部Agent公共接口&#xa;宿主文件移动重命名/自动永久删除&#xa;全站全格式、Monica最终UX、V3&#xa;不得写进本阶段已完成清单" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#eeedf0;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="570" y="680" width="460" height="205" as="geometry"/></mxCell>
<mxCell id="rkm8_g9" value="停止与交接&#xa;&#xa;DOC通过仅允许等待T01或人审&#xa;不表示T05/RKM-0已经开始&#xa;新Fatal/Major/疑似假绿立即停&#xa;模型不可用不静默Mock PASS&#xa;代码执行必须另获用户批准" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=16;fontFamily=Arial;fillColor=#fce6e6;strokeColor=#66716c;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="460" height="205" as="geometry"/></mxCell>
