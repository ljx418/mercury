        <mxCell id="p4-1" parent="p4-0" />
        <mxCell id="p4-title" parent="p4-1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="Cookie租约 / 字幕 / 音频 / OCR / VLM｜主路径与双回退" vertex="1">
          <mxGeometry height="42" width="1200" x="60" y="35" as="geometry" />
        </mxCell>
        <mxCell id="p4-policy" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=14;fontStyle=1;" value="PortalPermissionClient → PortalSessionBroker&#xa;五项scope持久到主动撤销&#xa;真实click请求；Background只复核" vertex="1">
          <mxGeometry height="120" width="260" x="60" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-click" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2eb;strokeColor=#0b765f;fontSize=15;fontStyle=1;" value="用户点击开始&#xa;V3-1.2候选能力已通过&#xa;UI bearer只创建短期channel" vertex="1">
          <mxGeometry height="90" width="260" x="60" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p4-grant" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2eb;strokeColor=#0b765f;fontSize=14;" value="V3-1.3 Credential Channel（已实现PASS）&#xa;精确Origin + 20秒一次性ticket&#xa;Background 9名envelope → 60秒Runtime内存lease&#xa;专用fetch；同body不重试" vertex="1">
          <mxGeometry height="120" width="260" x="360" y="295" as="geometry" />
        </mxCell>
        <mxCell id="p4-sub" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=14;" value="V3-2 固定四路线（仍BLOCKED）&#xa;0b已FAIL；5.3固定窗口仅为文档候选&#xa;1凭据字幕 → 2媒体ASR → 3公开字幕 → 4可信capture" vertex="1">
          <mxGeometry height="120" width="260" x="360" y="460" as="geometry" />
        </mxCell>
        <mxCell id="p4-asr" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=14;" value="TaskAudioRef → FixedWindowOrchestrator&#xa;8×15秒无重叠 → FunASR Adapter → NativeProcessHost&#xa;Tiny兜底；≤2×延迟；门户不得控制Provider" vertex="1">
          <mxGeometry height="120" width="300" x="730" y="370" as="geometry" />
        </mxCell>
        <mxCell id="p4-frame" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b74b8;fontSize=14;" value="MediaFramePipeline&#xa;任务期临时视频 → FFmpeg/OpenCV选帧&#xa;平台拒绝则可见帧回退" vertex="1">
          <mxGeometry height="120" width="300" x="730" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-ocr" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b74b8;fontSize=14;" value="LocalOcrAdapter&#xa;RapidOCR 本地处理&#xa;OcrEvidence" vertex="1">
          <mxGeometry height="120" width="240" x="760" y="220" as="geometry" />
        </mxCell>
        <mxCell id="p4-vlm" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=14;" value="D Governance → MediaVisionProvider&#xa;仅选定证据帧出站&#xa;provider/model/request/response hash" vertex="1">
