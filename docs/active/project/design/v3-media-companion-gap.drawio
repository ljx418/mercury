  <diagram id="v3-page-06" name="06 BiliNote迁移与治理">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />
        <mxCell id="p6-title" value="BiliNote 选择性迁移与安全治理｜固定 clean commit，防腐层接入" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="35" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p6-source" value="研究来源&#xa;GitHub JefferyHcool/BiliNote&#xa;clean commit be388939…&#xa;MIT License + license hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2eb;strokeColor=#0b765f;fontSize=15;fontStyle=1;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="140" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p6-allow" value="允许借鉴&#xa;Cookie字幕 / yt-dlp / ASR fallback&#xa;后台任务 / 抽帧 / 时间戳笔记&#xa;经Navia短租约与清理层重写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b74b8;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="440" y="120" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6-reject" value="拒绝迁移&#xa;整仓应用壳 / 账号 / SQLite / Chroma&#xa;明文Cookie配置 / 跨任务下载 / 绕过限制&#xa;Markdown marker 作为事实权威" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="440" y="360" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6-acl" value="Navia 防腐层&#xa;MediaPortalAdapter + Registry&#xa;B站首个实现；YouTube/XHS后续独立适配&#xa;MediaTask / Evidence / VideoOutline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=15;fontStyle=1;" vertex="1" parent="p6-1">
          <mxGeometry x="820" y="210" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6-license" value="V3-0 已冻结 reference_only 清单&#xa;6 个 clean-commit 文件 + source hash&#xa;清单外默认拒绝；当前不授权复制&#xa;未来复制须目标映射 + MIT + 独立预审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="390" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-dirty" value="本地 bilinote/ 有未提交修改&#xa;dirty diff 不得作为迁移来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="610" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6-privacy" value="隐私边界&#xa;Cookie值仅浏览器/内存/0600临时文件&#xa;不上传原始音频，只上传已选证据帧&#xa;public evidence 零 secret / 临时媒体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="1210" y="130" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-fail" value="Fail closed&#xa;Provider 无 vision capability / 未授权 / 请求失败&#xa;不得伪造画面理解；允许文本大纲 degraded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="1210" y="370" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-output" value="V3 产物&#xa;Navia 强类型合同与证据包&#xa;不依赖 BiliNote 运行时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2eb;strokeColor=#0b765f;fontSize=16;fontStyle=1;" vertex="1" parent="p6-1">
          <mxGeometry x="820" y="590" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-e1" edge="1" parent="p6-1" source="p6-source" target="p6-allow" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e2" edge="1" parent="p6-1" source="p6-allow" target="p6-acl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e3" edge="1" parent="p6-1" source="p6-acl" target="p6-output" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-e4" edge="1" parent="p6-1" source="p6-license" target="p6-acl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
