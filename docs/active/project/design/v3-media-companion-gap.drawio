        </mxCell>
        <mxCell id="p4-evidence" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2eb;strokeColor=#0b765f;fontSize=15;fontStyle=1;" value="分型 Evidence Index&#xa;subtitle / asr / ocr / vision_frame / metadata" vertex="1">
          <mxGeometry height="110" width="330" x="1175" y="340" as="geometry" />
        </mxCell>
        <mxCell id="p4-clean" parent="p4-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" value="V3-2 五终态清理屏障&#xa;succeeded/degraded/blocked/failed/cancelled&#xa;cookiefile·临时媒体·原始音视频·active capture=0" vertex="1">
