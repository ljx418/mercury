        <mxCell id="p7-title" parent="p7-1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="V3-0..V3-7 开发里程碑与自动验收｜前一门禁不过，不得进入下一阶段" vertex="1">
          <mxGeometry height="42" width="1300" x="60" y="35" as="geometry" />
        </mxCell>
        <mxCell id="p7-v30" parent="p7-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c28c13;fontSize=14;fontStyle=1;" value="V3-0 文档冻结&#xa;PRD/架构/合同/原型/8页图&#xa;内审×2 + 外审 + 用户授权" vertex="1">
