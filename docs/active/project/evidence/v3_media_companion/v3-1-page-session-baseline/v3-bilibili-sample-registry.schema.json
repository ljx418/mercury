{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3-bilibili-sample-registry/v1",
  "title": "Navia V3 Bilibili Sample Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "runId", "browser", "createdAt", "samples"],
  "properties": {
    "schemaVersion": { "const": "v3-bilibili-sample-registry/v1" },
    "revision": { "const": 1 },
    "runId": { "type": "string", "pattern": "^v3-1p-bilibili-probe-[0-9]{8}T[0-9]{6}Z$" },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profileClass"],
      "properties": {
        "name": { "const": "Google Chrome" },
        "version": { "type": "string", "minLength": 1 },
        "profileClass": { "const": "fresh_temporary_public" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "samples": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sampleId", "url", "bvid", "cid", "partCount", "durationSeconds", "title", "author", "primaryClass", "expectedOutcome", "subtitleEvidence", "classificationEvidence", "observedAt", "observationSha256", "screenshotPath", "screenshotSha256"],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^v3-sample-(0[1-9]|1[0-2])$" },
          "url": { "type": "string", "pattern": "^https://www\\.bilibili\\.com/video/BV[A-Za-z0-9]+/?$" },
          "bvid": { "type": "string", "pattern": "^BV[A-Za-z0-9]+$" },
          "cid": { "type": "string", "pattern": "^[0-9]+$" },
          "partCount": { "type": "integer", "minimum": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "primaryClass": { "enum": ["subtitle", "asr", "multipart", "restricted", "low_signal"] },
          "expectedOutcome": { "enum": ["success", "blocked", "degraded"] },
          "subtitleEvidence": { "enum": ["public_api_item", "page_player_item", "none", "restricted", "unknown"] },
          "classificationEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "observedAt": { "type": "string", "format": "date-time" },
          "observationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "screenshotPath": { "type": "string", "pattern": "^screenshots/v3-sample-(0[1-9]|1[0-2])\\.png$" },
          "screenshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
