{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navia.local/contracts/v3_media_capture_internal_relay_v1.schema.json",
  "title": "Navia V3 Internal Media Capture Relay Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "visibility", "portName", "audioShape", "limits", "ordering", "restartMarker", "messageTypes", "failureCodes", "stopReasons"],
  "properties": {
    "schemaVersion": { "const": "v3-media-capture-internal-relay/v1" },
    "visibility": { "const": "extension_internal_only" },
    "portName": { "const": "navia.mediaCapture.audio/v1" },
    "audioShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "sampleRateHz", "channels", "sampleWidthBytes", "payloadTransport"],
      "properties": {
        "encoding": { "const": "pcm_s16le" },
        "sampleRateHz": { "const": 16000 },
        "channels": { "const": 1 },
        "sampleWidthBytes": { "const": 2 },
        "payloadTransport": { "const": "transferable_array_buffer" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChunkBytes", "runtimeMaxInFlightChunks", "maxQueuedChunks", "maxQueuedBytes", "portConnectTimeoutMs", "runtimeStartTimeoutMs", "chunkAckTimeoutMs", "cleanupTimeoutMs", "finalizeTimeoutMs", "maxCaptureMs", "maxCaptureBytes"],
      "properties": {
        "maxChunkBytes": { "const": 65536 },
        "runtimeMaxInFlightChunks": { "const": 1 },
        "maxQueuedChunks": { "const": 32 },
        "maxQueuedBytes": { "const": 2097152 },
        "portConnectTimeoutMs": { "const": 5000 },
        "runtimeStartTimeoutMs": { "const": 10000 },
        "chunkAckTimeoutMs": { "const": 10000 },
        "cleanupTimeoutMs": { "const": 10000 },
        "finalizeTimeoutMs": { "const": 120000 },
        "maxCaptureMs": { "const": 900000 },
        "maxCaptureBytes": { "const": 536870912 }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstSequence", "increment", "ackSource", "chunkBeforeRuntimeStarted", "chunkAfterStop", "overflowBehavior"],
      "properties": {
        "firstSequence": { "const": 0 },
        "increment": { "const": 1 },
        "ackSource": { "const": "runtime_chunkAccepted" },
        "chunkBeforeRuntimeStarted": { "const": "reject" },
        "chunkAfterStop": { "const": "reject" },
        "overflowBehavior": { "const": "abort_without_drop" }
      }
    },
    "restartMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "fields", "forbiddenFields", "lifecycle", "restartBehavior"],
      "properties": {
        "storage": { "const": "chrome.storage.session" },
        "fields": { "const": ["captureSessionId", "taskIdSha256", "grantIdSha256", "startedAt"] },
        "forbiddenFields": { "const": ["ticket", "streamId", "pcm", "sourceIdentity", "absolutePath"] },
        "lifecycle": { "const": "write_before_runtime_connect_clear_after_terminal_or_reconcile" },
        "restartBehavior": { "const": "emit_worker_restarted_verify_runtime_sink_zero_never_resume" }
      }
    },
    "messageTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backgroundToOffscreen", "offscreenToBackground"],
      "properties": {
        "backgroundToOffscreen": { "const": ["start", "chunk_ack", "stop", "abort"] },
        "offscreenToBackground": { "const": ["ready", "chunk", "stopped", "capture_error"] }
      }
    },
    "failureCodes": {
      "const": [
        "V3_MEDIA_CAPTURE_PORT_FORBIDDEN",
        "V3_MEDIA_CAPTURE_PORT_DISCONNECTED",
        "V3_MEDIA_CAPTURE_PROTOCOL_INVALID",
        "V3_MEDIA_CAPTURE_BACKPRESSURE",
        "V3_MEDIA_CAPTURE_WORKER_RESTARTED",
        "V3_MEDIA_CAPTURE_RUNTIME_DISCONNECTED",
        "V3_MEDIA_CAPTURE_CLEANUP_INCOMPLETE",
        "V3_MEDIA_CAPTURE_AUDIO_SHAPE_INVALID",
        "V3_MEDIA_CAPTURE_CHUNK_INVALID",
        "V3_MEDIA_CAPTURE_CHUNK_SEQUENCE_INVALID",
        "V3_MEDIA_CAPTURE_BYTE_LIMIT",
        "V3_MEDIA_CAPTURE_DURATION_LIMIT",
        "V3_MEDIA_CAPTURE_EMPTY",
        "V3_MEDIA_CAPTURE_STREAM_INVALID",
        "V3_MEDIA_CAPTURE_TICKET_INVALID",
        "V3_MEDIA_CAPTURE_TICKET_EXPIRED",
        "V3_MEDIA_CAPTURE_TICKET_REPLAYED",
        "V3_MEDIA_CAPTURE_BINDING_MISMATCH",
        "V3_MEDIA_CAPTURE_ALREADY_ACTIVE",
        "V3_MEDIA_CAPTURE_FINALIZE_FAILED"
      ]
    },
    "stopReasons": {
      "const": ["completed", "cancelled", "navigation", "tab_closed", "consent_revoked", "runtime_disconnected", "timeout", "failed"]
    }
  }
}
