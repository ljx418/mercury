{
  "schemaVersion": "v3-media-capture-internal-relay-fixtures/v1",
  "protocol": {
    "schemaVersion": "v3-media-capture-internal-relay/v1",
    "visibility": "extension_internal_only",
    "portName": "navia.mediaCapture.audio/v1",
    "audioShape": {
      "encoding": "pcm_s16le",
      "sampleRateHz": 16000,
      "channels": 1,
      "sampleWidthBytes": 2,
      "payloadTransport": "transferable_array_buffer"
    },
    "limits": {
      "maxChunkBytes": 65536,
      "runtimeMaxInFlightChunks": 1,
      "maxQueuedChunks": 32,
      "maxQueuedBytes": 2097152,
      "portConnectTimeoutMs": 5000,
      "runtimeStartTimeoutMs": 10000,
      "chunkAckTimeoutMs": 10000,
      "cleanupTimeoutMs": 10000,
      "finalizeTimeoutMs": 120000,
      "maxCaptureMs": 900000,
      "maxCaptureBytes": 536870912
    },
    "ordering": {
      "firstSequence": 0,
      "increment": 1,
      "ackSource": "runtime_chunkAccepted",
      "chunkBeforeRuntimeStarted": "reject",
      "chunkAfterStop": "reject",
      "overflowBehavior": "abort_without_drop"
    },
    "restartMarker": {
      "storage": "chrome.storage.session",
      "fields": ["captureSessionId", "taskIdSha256", "grantIdSha256", "startedAt"],
      "forbiddenFields": ["ticket", "streamId", "pcm", "sourceIdentity", "absolutePath"],
      "lifecycle": "write_before_runtime_connect_clear_after_terminal_or_reconcile",
      "restartBehavior": "emit_worker_restarted_verify_runtime_sink_zero_never_resume"
    },
    "messageTypes": {
      "backgroundToOffscreen": ["start", "chunk_ack", "stop", "abort"],
      "offscreenToBackground": ["ready", "chunk", "stopped", "capture_error"]
    },
    "failureCodes": [
      "V3_MEDIA_CAPTURE_PORT_FORBIDDEN",
      "V3_MEDIA_CAPTURE_PORT_DISCONNECTED",
      "V3_MEDIA_CAPTURE_PROTOCOL_INVALID",
      "V3_MEDIA_CAPTURE_BACKPRESSURE",
      "V3_MEDIA_CAPTURE_WORKER_RESTARTED",
      "V3_MEDIA_CAPTURE_RUNTIME_DISCONNECTED",
      "V3_MEDIA_CAPTURE_CLEANUP_INCOMPLETE",
      "V3_MEDIA_CAPTURE_AUDIO_SHAPE_INVALID",
      "V3_MEDIA_CAPTURE_CHUNK_INVALID",
      "V3_MEDIA_CAPTURE_CHUNK_SEQUENCE_INVALID",
      "V3_MEDIA_CAPTURE_BYTE_LIMIT",
      "V3_MEDIA_CAPTURE_DURATION_LIMIT",
      "V3_MEDIA_CAPTURE_EMPTY",
      "V3_MEDIA_CAPTURE_STREAM_INVALID",
      "V3_MEDIA_CAPTURE_TICKET_INVALID",
      "V3_MEDIA_CAPTURE_TICKET_EXPIRED",
      "V3_MEDIA_CAPTURE_TICKET_REPLAYED",
      "V3_MEDIA_CAPTURE_BINDING_MISMATCH",
      "V3_MEDIA_CAPTURE_ALREADY_ACTIVE",
      "V3_MEDIA_CAPTURE_FINALIZE_FAILED"
    ],
    "stopReasons": ["completed", "cancelled", "navigation", "tab_closed", "consent_revoked", "runtime_disconnected", "timeout", "failed"]
  },
  "positiveTrace": [
    { "step": 1, "actor": "background", "message": "runtime_start", "requiredState": "connecting" },
    { "step": 2, "actor": "runtime", "message": "started", "requiredState": "runtime_started" },
    { "step": 3, "actor": "background", "message": "start", "requiredState": "runtime_started" },
    { "step": 4, "actor": "offscreen", "message": "ready", "requiredState": "capturing" },
    { "step": 5, "actor": "offscreen", "message": "chunk", "sequence": 0, "byteLength": 8192 },
    { "step": 6, "actor": "runtime", "message": "chunkAccepted", "sequence": 0, "byteLength": 8192 },
    { "step": 7, "actor": "background", "message": "chunk_ack", "sequence": 0 },
    { "step": 8, "actor": "offscreen", "message": "stopped", "requiredState": "stopping" },
    { "step": 9, "actor": "runtime", "message": "completed", "requiredState": "finalized" }
  ],
  "negativeCases": [
    { "caseId": "RLY-N01", "mutation": "sender_id_mismatch", "expectedFailureCode": "V3_MEDIA_CAPTURE_PORT_FORBIDDEN" },
    { "caseId": "RLY-N02", "mutation": "sender_url_not_exact_offscreen", "expectedFailureCode": "V3_MEDIA_CAPTURE_PORT_FORBIDDEN" },
    { "caseId": "RLY-N03", "mutation": "sender_has_tab", "expectedFailureCode": "V3_MEDIA_CAPTURE_PORT_FORBIDDEN" },
    { "caseId": "RLY-N04", "mutation": "chunk_before_runtime_started", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N05", "mutation": "first_sequence_is_one", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N06", "mutation": "duplicate_sequence", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N07", "mutation": "sequence_gap", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N08", "mutation": "byte_length_mismatch", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N09", "mutation": "chunk_exceeds_65536", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N10", "mutation": "queued_chunks_exceeds_32", "expectedFailureCode": "V3_MEDIA_CAPTURE_BACKPRESSURE" },
    { "caseId": "RLY-N11", "mutation": "queued_bytes_exceeds_2097152", "expectedFailureCode": "V3_MEDIA_CAPTURE_BACKPRESSURE" },
    { "caseId": "RLY-N12", "mutation": "runtime_ack_timeout", "expectedFailureCode": "V3_MEDIA_CAPTURE_RUNTIME_DISCONNECTED" },
    { "caseId": "RLY-N13", "mutation": "port_disconnect", "expectedFailureCode": "V3_MEDIA_CAPTURE_PORT_DISCONNECTED" },
    { "caseId": "RLY-N14", "mutation": "service_worker_restart_with_uncleared_session_marker", "expectedFailureCode": "V3_MEDIA_CAPTURE_WORKER_RESTARTED" },
    { "caseId": "RLY-N15", "mutation": "chunk_after_stop", "expectedFailureCode": "V3_MEDIA_CAPTURE_PROTOCOL_INVALID" },
    { "caseId": "RLY-N16", "mutation": "cleanup_timeout", "expectedFailureCode": "V3_MEDIA_CAPTURE_CLEANUP_INCOMPLETE" }
  ]
}
