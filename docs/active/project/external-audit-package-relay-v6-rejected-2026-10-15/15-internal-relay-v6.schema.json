    "restartMarker": {"const":{"storage":"chrome.storage.session","accessLevel":"TRUSTED_CONTEXTS","schemaVersion":"v3-media-capture-restart-marker/v6","fields":["schemaVersion","captureSessionId","taskId","startedAt","phase","expiresAt"],"captureSessionId":"cap_ plus 32 base64url chars from 192 random bits","phaseValues":["connecting","runtime_started","capturing","draining","cleanup_pending"],"phaseTransitions":["connecting->runtime_started","runtime_started->capturing","capturing->draining","draining->cleanup_pending"],"expiryRule":"set_once_startedAt_plus_1080000_never_refresh","maxRetentionMs":1080000,"forbiddenFields":["ticket","grantId","streamId","pcm","sourceIdentity","absolutePath","cookie","apiKey"],"clearRule":"after_phase_owner_receipt_and_cleanup_grace","restartBehavior":"phase_dispatch_to_existing_DELETE_or_runtime_finally_or_existing_recover_never_resume_old_pcm_ticket_or_sequence"}},
