    "limits": {"const":{"maxRawChunkBytes":49152,"maxEncodedChunkChars":65536,"creditWindowChunks":1,"runtimeMaxInFlightChunks":1,"maxOutstandingChunks":32,"maxOutstandingRawBytes":1572864,"portConnectTimeoutMs":5000,"runtimeStartTimeoutMs":10000,"chunkAckTimeoutMs":10000,"cleanupTimeoutMs":10000,"finalizeTimeoutMs":120000,"maxCaptureMs":900000,"maxCaptureBytes":536870912}},
    "ordering": {"const":{"firstSequence":0,"increment":1,"ackSource":"runtime_chunkAccepted","creditReturn":"after_runtime_ack_only","chunkOwnership":"local_queued_xor_credit_consumed_runtime_inflight","capacityRule":"abort_before_enqueue_would_exceed_limit","quiesceRule":"stop_audio_source_then_drain_existing_queue_under_credit","chunkRejectBoundary":"runtime_stop_sent","overflowBehavior":"abort_without_drop"}},
