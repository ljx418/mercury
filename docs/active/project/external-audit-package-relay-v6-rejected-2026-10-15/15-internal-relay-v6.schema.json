    "restartMarkerInstance": {"type":"object","additionalProperties":false,"required":["schemaVersion","captureSessionId","taskId","startedAt","phase","expiresAt"],"properties":{"schemaVersion":{"const":"v3-media-capture-restart-marker/v6"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"taskId":{"type":"string","pattern":"^media_task_[a-f0-9]{32}$"},"startedAt":{"type":"string","format":"date-time"},"phase":{"enum":["connecting","runtime_started","capturing","draining","cleanup_pending"]},"expiresAt":{"type":"string","format":"date-time"}}},
