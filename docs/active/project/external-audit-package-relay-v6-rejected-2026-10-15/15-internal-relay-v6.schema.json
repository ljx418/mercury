    "start": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","streamId","audioConfig"],"properties":{"type":{"const":"start"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"streamId":{"type":"string","minLength":1,"maxLength":512},"audioConfig":{"$ref":"#/$defs/audioConfig"}}},
    "credit": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","acknowledgedSequence","credit"],"properties":{"type":{"const":"chunk_credit"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"acknowledgedSequence":{"type":"integer","minimum":-1},"credit":{"const":1}}},
    "quiesce": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","reason"],"properties":{"type":{"const":"quiesce"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"reason":{"const":"completed"}}},
    "abort": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","failureCode"],"properties":{"type":{"const":"abort"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"failureCode":{"$ref":"#/$defs/failureCode"}}},
    "ready": {"type":"object","additionalProperties":false,"required":["type","captureSessionId"],"properties":{"type":{"const":"ready"},"captureSessionId":{"$ref":"#/$defs/sessionId"}}},
    "chunk": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","sequence","rawByteLength","pcmBase64"],"properties":{"type":{"const":"chunk"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"sequence":{"type":"integer","minimum":0},"rawByteLength":{"type":"integer","minimum":2,"maximum":49152,"multipleOf":2},"pcmBase64":{"type":"string","minLength":4,"maxLength":65536,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}}},
    "quiesced": {"type":"object","additionalProperties":false,"required":["type","captureSessionId","queuedChunks","outstandingRawBytes","sourceStopped"],"properties":{"type":{"const":"quiesced"},"captureSessionId":{"$ref":"#/$defs/sessionId"},"queuedChunks":{"type":"integer","minimum":0,"maximum":32},"outstandingRawBytes":{"type":"integer","minimum":0,"maximum":1572864},"sourceStopped":{"const":true}}},
