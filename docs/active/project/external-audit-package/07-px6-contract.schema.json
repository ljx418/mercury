        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A16"}, "status": {"const": "pending"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "FinalPassedAcceptanceResults": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/AcceptanceResult"},
      "allOf": [
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A01"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A02"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A03"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A04"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A05"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A06"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A07"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
