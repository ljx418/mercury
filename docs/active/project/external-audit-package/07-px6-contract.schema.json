        "candidateBinding": {"$ref": "#/$defs/ArtifactRef"},
        "machineExitAudit": {"$ref": "#/$defs/ArtifactRef"},
        "reviewSubmission": {"$ref": "#/$defs/ArtifactRef"},
        "status": {"enum": ["passed", "failed"]},
        "acceptanceResults": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/AcceptanceResult"}},
        "gateStatus": {"$ref": "#/$defs/GateStatus"},
        "humanReviewStatus": {"enum": ["passed", "failed"]},
        "g7Status": {"enum": ["passed", "failed"]},
        "finalPassed": {"type": "boolean"},
        "fatal": {"type": "integer", "minimum": 0},
        "major": {"type": "integer", "minimum": 0},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/Issue"}},
        "claim": {"enum": ["PX-6 contract fixture passed; not product acceptance evidence.", "V2-PX External Brain Productization passed dual-container real-Chrome acceptance.", "V2-PX External Brain Productization acceptance did not pass."]},
        "contentSha256": {"$ref": "#/$defs/Sha256"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"acceptanceResults": {"$ref": "#/$defs/FinalPassedAcceptanceResults"}, "gateStatus": {"properties": {"G1_entry": {"const": "passed"}, "G2_route": {"const": "passed"}, "G3_lifecycle": {"const": "passed"}, "G4_architecture": {"const": "passed"}, "G5_status": {"const": "passed"}, "G6_ux_accessibility": {"const": "passed"}, "G7_evidence": {"const": "passed"}}}, "finalPassed": {"const": true}, "humanReviewStatus": {"const": "passed"}, "g7Status": {"const": "passed"}, "fatal": {"const": 0}, "major": {"const": 0}, "issues": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"finalPassed": {"const": false}, "claim": {"const": "V2-PX External Brain Productization acceptance did not pass."}}}},
        {"if": {"properties": {"status": {"const": "passed"}, "evidenceClass": {"const": "contract_fixture"}}, "required": ["status", "evidenceClass"]}, "then": {"properties": {"claim": {"const": "PX-6 contract fixture passed; not product acceptance evidence."}}}},
        {"if": {"properties": {"status": {"const": "passed"}, "evidenceClass": {"const": "production_acceptance"}}, "required": ["status", "evidenceClass"]}, "then": {"properties": {"claim": {"const": "V2-PX External Brain Productization passed dual-container real-Chrome acceptance."}}}}
      ]
    },
    "PX6CollectionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "px6RunId", "status", "createdAt", "issues", "candidateGenerated"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-collection-diagnostic/v1"},
        "px6RunId": {"type": "string", "pattern": "^px6-[a-z0-9-]+$"},
        "status": {"const": "blocked"},
        "createdAt": {"$ref": "#/$defs/DateTime"},
        "issues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Issue"}},
        "candidateGenerated": {"const": false}
      }
    }
  }
