  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "DateTime": {"type": "string", "format": "date-time"},
    "RelativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"},
    "EvidenceClass": {"enum": ["contract_fixture", "production_acceptance"]},
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRoot", "path", "sha256", "byteLength", "mediaType"],
      "properties": {
        "artifactRoot": {"enum": ["t04_candidate", "t04_external_audit", "px6_run", "repository_snapshot"]},
        "path": {"$ref": "#/$defs/RelativePath"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "byteLength": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "FailureCode": {
      "enum": [
        "PX6_T04_EXIT_MANIFEST_HASH_MISMATCH",
        "PX6_T04_EXIT_MANIFEST_CONTENT_MISMATCH",
        "PX6_T04_INDEPENDENT_AUDIT_MISMATCH",
        "PX6_T04_ARTIFACT_ROOT_UNRESOLVED",
        "PX6_LEGACY_PIPELINE_FORBIDDEN",
        "PX6_SOURCE_SCENARIO_DENOMINATOR_MISMATCH",
        "PX6_ROUTE_MATRIX_INCOMPLETE",
        "PX6_FORGET_RECOVERY_INCOMPLETE",
        "PX6_UX_OR_FAULT_EVIDENCE_INCOMPLETE",
        "PX6_VALIDATION_DENOMINATOR_MISMATCH",
        "PX6_CROSS_RUN_EVIDENCE_MIXED",
        "PX6_T04_EVIDENCE_MUTATED",
        "PX6_DOCUMENT_OR_DRAWIO_STATE_MISMATCH",
        "PX6_AUTOMATED_REVIEWER_FORBIDDEN",
        "PX6_HUMAN_AUTHORIZATION_INVALID",
        "PX6_HUMAN_GATE_INCOMPLETE",
        "PX6_HUMAN_FAILURE_WITHOUT_BLOCKER",
        "PX6_REPORT_PROMOTED_BEFORE_REVIEW",
        "PX6_G7_FINAL_STATE_INVALID",
        "PX6_CLAIM_OR_FINAL_AUDIT_OVERREACH"
      ]
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureCode", "message"],
      "properties": {
        "failureCode": {"$ref": "#/$defs/FailureCode"},
        "message": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/ArtifactRef"}
      }
    },
    "AcceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceId", "status", "evidenceRefs"],
      "properties": {
        "acceptanceId": {"type": "string", "pattern": "^PX6-A(0[1-9]|1[0-6])$"},
        "status": {"enum": ["passed", "pending", "failed"]},
        "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"evidenceRefs": {"minItems": 1}}}}
      ]
    },
    "GateStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G1_entry", "G2_route", "G3_lifecycle", "G4_architecture", "G5_status", "G6_ux_accessibility", "G7_evidence"],
      "properties": {
        "G1_entry": {"enum": ["passed", "failed", "pending"]},
        "G2_route": {"enum": ["passed", "failed", "pending"]},
        "G3_lifecycle": {"enum": ["passed", "failed", "pending"]},
        "G4_architecture": {"enum": ["passed", "failed", "pending"]},
        "G5_status": {"enum": ["passed", "failed", "pending"]},
        "G6_ux_accessibility": {"enum": ["passed", "failed", "pending"]},
        "G7_evidence": {"enum": ["passed", "failed", "pending"]}
      }
    },
    "Denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionScenarios", "sources", "webSources", "localSources", "noteSources", "routeCells", "forgetRecoveryChains", "faultClasses", "viewportClasses", "axeSerious", "axeCritical", "keyboardPassed", "keyboardTotal", "validationRules", "machineRulesPassed", "humanRulesPending", "contractFixtures", "productionMutations", "t04Acceptance", "t04Negatives"],
      "properties": {
        "productionScenarios": {"const": 17},
        "sources": {"const": 12},
        "webSources": {"const": 6},
        "localSources": {"const": 3},
        "noteSources": {"const": 3},
        "routeCells": {"const": 20},
        "forgetRecoveryChains": {"const": 12},
        "faultClasses": {"const": 4},
        "viewportClasses": {"const": 4},
        "axeSerious": {"const": 0},
        "axeCritical": {"const": 0},
        "keyboardPassed": {"const": 5},
        "keyboardTotal": {"const": 5},
        "validationRules": {"const": 63},
        "machineRulesPassed": {"const": 61},
        "humanRulesPending": {"const": 2},
        "contractFixtures": {"const": 109},
        "productionMutations": {"const": 42},
        "t04Acceptance": {"const": 14},
        "t04Negatives": {"const": 25}
      }
    },
    "MachineWaitingAcceptanceResults": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/AcceptanceResult"},
      "allOf": [
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A01"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"acceptanceId": {"const": "PX6-A02"}, "status": {"const": "passed"}}, "required": ["acceptanceId", "status"]}, "minContains": 1, "maxContains": 1},
