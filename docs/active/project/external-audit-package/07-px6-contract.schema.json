        "humanReview": {"$ref": "#/$defs/ArtifactRef"},
        "reviewAuthorization": {"$ref": "#/$defs/ReviewAuthorization"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewedAt": {"$ref": "#/$defs/DateTime"},
        "status": {"enum": ["passed", "failed"]},
        "gateReviews": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/GateReview"},
          "allOf": [
            {"contains": {"properties": {"gateId": {"const": "G1"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G2"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G3"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G4"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G5"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G6"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G7"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "blockingIssues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "signedClaim": {"enum": ["PX-6 contract fixture passed; not product acceptance evidence.", "V2-PX External Brain Productization passed dual-container real-Chrome acceptance.", "V2-PX External Brain Productization acceptance did not pass."]},
        "submittedByAutomation": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"gateReviews": {"items": {"allOf": [{"$ref": "#/$defs/GateReview"}, {"properties": {"status": {"const": "passed"}}}]}}, "blockingIssues": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"gateReviews": {"contains": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "minContains": 1}, "blockingIssues": {"minItems": 1}, "signedClaim": {"const": "V2-PX External Brain Productization acceptance did not pass."}}}},
        {"if": {"properties": {"status": {"const": "passed"}, "evidenceClass": {"const": "contract_fixture"}}, "required": ["status", "evidenceClass"]}, "then": {"properties": {"signedClaim": {"const": "PX-6 contract fixture passed; not product acceptance evidence."}}}},
        {"if": {"properties": {"status": {"const": "passed"}, "evidenceClass": {"const": "production_acceptance"}}, "required": ["status", "evidenceClass"]}, "then": {"properties": {"signedClaim": {"const": "V2-PX External Brain Productization passed dual-container real-Chrome acceptance."}}}}
      ]
    },
    "FinalDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "candidateBinding", "machineExitAudit", "reviewSubmission", "status", "acceptanceResults", "gateStatus", "humanReviewStatus", "g7Status", "finalPassed", "fatal", "major", "issues", "claim", "contentSha256"],
      "properties": {
