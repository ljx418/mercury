    "CandidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "t04RunId", "snapshotCommit", "exitManifestRawSha256", "exitManifestContentSha256", "exitManifest", "publicEvidenceArchive", "independentImplementationAudit", "independentAuditFatal", "independentAuditMajor", "artifactRootConsistency", "denominators"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-candidate-binding/v1"},
        "evidenceClass": {"$ref": "#/$defs/EvidenceClass"},
        "px6RunId": {"type": "string", "pattern": "^px6-[a-z0-9-]+$"},
        "t04RunId": {"type": "string", "pattern": "^t04-r4-[a-z0-9-]+$"},
        "snapshotCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "exitManifestRawSha256": {"$ref": "#/$defs/Sha256"},
        "exitManifestContentSha256": {"$ref": "#/$defs/Sha256"},
        "exitManifest": {"$ref": "#/$defs/ArtifactRef"},
        "publicEvidenceArchive": {"$ref": "#/$defs/ArtifactRef"},
        "independentImplementationAudit": {"$ref": "#/$defs/ArtifactRef"},
        "independentAuditFatal": {"const": 0},
        "independentAuditMajor": {"const": 0},
        "artifactRootConsistency": {"const": "closed"},
        "denominators": {"$ref": "#/$defs/Denominators"}
      }
    },
    "MachineExitAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "candidateBinding", "status", "machinePassed", "acceptanceResults", "gateStatus", "humanReviewStatus", "g7Status", "finalPassed", "issues", "claim", "contentSha256"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-machine-exit-audit/v1"},
        "evidenceClass": {"$ref": "#/$defs/EvidenceClass"},
        "px6RunId": {"type": "string", "pattern": "^px6-[a-z0-9-]+$"},
        "candidateBinding": {"$ref": "#/$defs/ArtifactRef"},
        "status": {"enum": ["waiting_for_human_review", "blocked"]},
        "machinePassed": {"type": "boolean"},
        "acceptanceResults": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/AcceptanceResult"}},
        "gateStatus": {"$ref": "#/$defs/GateStatus"},
        "humanReviewStatus": {"const": "pending"},
        "g7Status": {"const": "pending"},
        "finalPassed": {"const": false},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/Issue"}},
        "claim": {"enum": ["PX-6 machine review package is ready for human review.", "PX-6 machine exit validation did not pass."]},
        "contentSha256": {"$ref": "#/$defs/Sha256"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "waiting_for_human_review"}}, "required": ["status"]}, "then": {"properties": {"machinePassed": {"const": true}, "acceptanceResults": {"$ref": "#/$defs/MachineWaitingAcceptanceResults"}, "gateStatus": {"properties": {"G1_entry": {"const": "passed"}, "G2_route": {"const": "passed"}, "G3_lifecycle": {"const": "passed"}, "G4_architecture": {"const": "passed"}, "G5_status": {"const": "passed"}, "G6_ux_accessibility": {"const": "passed"}, "G7_evidence": {"const": "pending"}}}, "issues": {"maxItems": 0}, "claim": {"const": "PX-6 machine review package is ready for human review."}}}},
        {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"properties": {"machinePassed": {"const": false}, "issues": {"minItems": 1}, "claim": {"const": "PX-6 machine exit validation did not pass."}}}}
      ]
    },
    "EvidenceIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "status", "candidateArtifacts", "machineArtifacts", "reviewArtifacts", "finalArtifacts", "contentSha256"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-evidence-index/v1"},
        "evidenceClass": {"$ref": "#/$defs/EvidenceClass"},
        "px6RunId": {"type": "string", "pattern": "^px6-[a-z0-9-]+$"},
        "status": {"enum": ["waiting_for_human_review", "finalized"]},
        "candidateArtifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/ArtifactRef"}},
        "machineArtifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/ArtifactRef"}},
        "reviewArtifacts": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}},
        "finalArtifacts": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}},
        "contentSha256": {"$ref": "#/$defs/Sha256"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "waiting_for_human_review"}}, "required": ["status"]}, "then": {"properties": {"reviewArtifacts": {"maxItems": 0}, "finalArtifacts": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "finalized"}}, "required": ["status"]}, "then": {"properties": {"reviewArtifacts": {"minItems": 1}, "finalArtifacts": {"minItems": 1}}}}
      ]
    },
    "ReviewInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "precondition", "actions", "expectedObservations", "threshold", "evidenceRefs", "failureDisposition"],
      "properties": {
        "gateId": {"enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7"]},
        "precondition": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expectedObservations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "threshold": {"type": "string", "minLength": 1},
        "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ArtifactRef"}},
        "failureDisposition": {"const": "mark_gate_failed_and_block_final_pass"}
      }
    },
    "ReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "candidateBinding", "machineExitAudit", "status", "gateInstructions", "automatedApprovalAllowed", "contentSha256"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-review-request/v1"},
        "evidenceClass": {"$ref": "#/$defs/EvidenceClass"},
        "px6RunId": {"type": "string", "pattern": "^px6-[a-z0-9-]+$"},
        "candidateBinding": {"$ref": "#/$defs/ArtifactRef"},
        "machineExitAudit": {"$ref": "#/$defs/ArtifactRef"},
        "status": {"const": "waiting_for_human_review"},
        "gateInstructions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/ReviewInstruction"},
          "allOf": [
            {"contains": {"properties": {"gateId": {"const": "G1"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G2"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G3"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G4"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G5"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G6"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"gateId": {"const": "G7"}}, "required": ["gateId"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "automatedApprovalAllowed": {"const": false},
        "contentSha256": {"$ref": "#/$defs/Sha256"}
