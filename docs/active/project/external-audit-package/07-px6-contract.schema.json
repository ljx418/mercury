    {"requirementId": "PX6-N-011", "requirementKey": "single_run_provenance", "failureCode": "PX6_CROSS_RUN_EVIDENCE_MIXED", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-012", "requirementKey": "t04_candidate_immutable", "failureCode": "PX6_T04_EVIDENCE_MUTATED", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-013", "requirementKey": "active_document_drawio_state", "failureCode": "PX6_DOCUMENT_OR_DRAWIO_STATE_MISMATCH", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-014", "requirementKey": "automation_cannot_sign", "failureCode": "PX6_AUTOMATED_REVIEWER_FORBIDDEN", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-015", "requirementKey": "human_authorization_integrity", "failureCode": "PX6_HUMAN_AUTHORIZATION_INVALID", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-016", "requirementKey": "all_human_gates_pass", "failureCode": "PX6_HUMAN_GATE_INCOMPLETE", "enforcementLayer": "semantic"},
    {"requirementId": "PX6-N-017", "requirementKey": "human_failure_has_blocker", "failureCode": "PX6_HUMAN_FAILURE_WITHOUT_BLOCKER", "enforcementLayer": "semantic"},
