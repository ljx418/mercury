    "ReviewSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceClass", "px6RunId", "candidateExitManifestRawSha256", "machineExitAuditRawSha256", "humanReview", "reviewAuthorization", "reviewer", "reviewedAt", "status", "gateReviews", "blockingIssues", "signedClaim", "submittedByAutomation"],
      "properties": {
        "schemaVersion": {"const": "v2-px6-review-submission/v1"},
